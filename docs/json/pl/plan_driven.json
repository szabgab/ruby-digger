{"gems":{"name":"plan_driven","downloads":170,"version":"0.2.0","version_created_at":"2026-09-30T17:37:27.484Z","version_downloads":65,"platform":"ruby","ruby_abi":null,"authors":"Ivan Blažević","info":"plan_driven runs a Rails team's delivery process from the command line. A terminal interview\nturns an idea into an implementation plan grounded in your real schema; the plan is checked\nby guards written in Ruby, rendered to PDF and approved. Approved plans become tickets, each\nticket is handed to a Cursor cloud agent that opens a pull request, and only pull requests\nyou approve are merged. Acceptance criteria map to Cucumber scenarios, and every phase leaves\ndocumentation behind: the plan, the tickets, the pull requests and a delivery report.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/blaz1988/plan-driven/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/blaz1988/plan-driven/issues","source_code_uri":"https://github.com/blaz1988/plan-driven","documentation_uri":"https://github.com/blaz1988/plan-driven#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"772620b3bee9cf19f9cd31b35de7f2b64a2ee38a1a1e4d8fe5c22712519634d7","spec_sha":"25a615b633357cb55a9ccfe3aa0c61289a081001737a3a3439305d6dabf23cd9","project_uri":"https://rubygems.org/gems/plan_driven","gem_uri":"https://rubygems.org/gems/plan_driven-0.2.0.gem","homepage_uri":"https://github.com/blaz1988/plan-driven","wiki_uri":null,"documentation_uri":"https://github.com/blaz1988/plan-driven#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/blaz1988/plan-driven","bug_tracker_uri":"https://github.com/blaz1988/plan-driven/issues","changelog_uri":"https://github.com/blaz1988/plan-driven/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activerecord","requirements":">= 7.0, < 9"},{"name":"railties","requirements":">= 7.0, < 9"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/bl