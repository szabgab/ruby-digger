{"gems":{"name":"enola","downloads":2280,"version":"0.4.4","version_created_at":"2026-08-23T12:07:00.083Z","version_downloads":130,"platform":"ruby","authors":"Muhamed Isabegovic","info":"A pure-Ruby wrapper around enola, the architecture-graph tool by enola-labs.\nThe gem's version is the upstream release it drives. The binary is not in\nthe gem: the first command that needs it downloads the release for your\nplatform, verifies it against the checksum the release publishes, and keeps\nit in a per-user cache. Every command and exit code is forwarded unchanged.\nThis gem is not an enola-labs release.\n","licenses":["Apache-2.0"],"metadata":{"changelog_uri":"https://github.com/misabegovic/enola-rb/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/misabegovic/enola-rb"},"yanked":false,"sha":"ba6b25b1a123f3919fce04aac827bfb5ea62a037468a07497f8a62424696b054","spec_sha":"3d7e87fccdce74d02cbf82f9e86874c63c0a57bb3d2a856808b7a86847ef27bb","project_uri":"https://rubygems.org/gems/enola","gem_uri":"https://rubygems.org/gems/enola-0.4.4.gem","homepage_uri":"https://github.com/misabegovic/enola-rb","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/misabegovic/enola-rb","bug_tracker_uri":null,"changelog_uri":"https://github.com/misabegovic/enola-rb/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"prism","requirements":">= 1.3"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/misabegovic/enola-rb"}