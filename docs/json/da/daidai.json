{"gems":{"name":"daidai","downloads":2108,"version":"0.2.5","version_created_at":"2026-08-03T01:27:58.068Z","version_downloads":6,"platform":"ruby","authors":"davafons","info":"Daidai is a table-driven, pure-Ruby port of jconj's conjugation algorithm, built on the JMdictDB conjugation tables. It conjugates Japanese verbs and adjectives from a dictionary-form word and its JMdict part-of-speech code, with no native extension and nothing to download at runtime.","licenses":["GPL-3.0-only"],"metadata":{"changelog_uri":"https://github.com/davafons/daidai/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/davafons/daidai/issues","source_code_uri":"https://github.com/davafons/daidai","rubygems_mfa_required":"true"},"yanked":false,"sha":"2caa1a719b90bfec26795f2c76f279979462ce65bac5c050fd14edd1c763749a","spec_sha":"48f91e9f018d7dac902df7b8d7377b78ae68a1ab79f12053f30cbe786eced8af","project_uri":"https://rubygems.org/gems/daidai","gem_uri":"https://rubygems.org/gems/daidai-0.2.5.gem","homepage_uri":"https://github.com/davafons/daidai","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/davafons/daidai","bug_tracker_uri":"https://github.com/davafons/daidai/issues","changelog_uri":"https://github.com/davafons/daidai/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"minitest","requirements":"~> 5.0"},{"name":"rake","requirements":"~> 13.0"},{"name":"rubocop","requirements":"~> 1.0"}],"runtime":[{"name":"csv","requirements":">= 0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/davafons/daidai"}