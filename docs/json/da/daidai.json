{"gems":{"name":"daidai","downloads":1017,"version":"0.2.2","version_created_at":"2026-07-25T08:32:55.526Z","version_downloads":2,"platform":"ruby","authors":"davafons","info":"Daidai is a table-driven, pure-Ruby port of jconj's conjugation algorithm, built on the JMdictDB conjugation tables. It conjugates Japanese verbs and adjectives from a dictionary-form word and its JMdict part-of-speech code, with no native extension and nothing to download at runtime.","licenses":["GPL-3.0-only"],"metadata":{"changelog_uri":"https://github.com/davafons/daidai/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/davafons/daidai/issues","source_code_uri":"https://github.com/davafons/daidai","rubygems_mfa_required":"true"},"yanked":false,"sha":"b5648a46c1e8e17118e2a13f7a37b35f5460b11ce7e22583457130ac48012b7b","spec_sha":"a1edd775939e026586c4d7786ca543de407573b5182a1a5db2f442df12fb9a62","project_uri":"https://rubygems.org/gems/daidai","gem_uri":"https://rubygems.org/gems/daidai-0.2.2.gem","homepage_uri":"https://github.com/davafons/daidai","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/davafons/daidai","bug_tracker_uri":"https://github.com/davafons/daidai/issues","changelog_uri":"https://github.com/davafons/daidai/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"minitest","requirements":"~> 5.0"},{"name":"rake","requirements":"~> 13.0"},{"name":"rubocop","requirements":"~> 1.0"}],"runtime":[{"name":"csv","requirements":">= 0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/davafons/daidai"}