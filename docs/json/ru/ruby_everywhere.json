{"gems":{"name":"ruby_everywhere","downloads":16745,"version":"0.14.0","version_created_at":"2026-09-05T00:09:37.595Z","version_downloads":14,"platform":"ruby","ruby_abi":null,"authors":"Andrea Fomera","info":"RubyEverywhere gives a Rails (or Sinatra, or Hanami) app a native life on desktop, iOS, and Android. Desktop is a Tauri shell — in local mode the whole app is pressed into a single-file binary with Tebako and runs on-device with no Ruby install; in remote mode the shell wraps your deployed app. iOS and Android are Hotwire Native shells with a real tab bar, nav-bar buttons, menus, notifications, haptics, biometrics, and deep links. One config file, one CLI, one JavaScript bridge, with the web app staying the source of truth.","licenses":["MIT"],"metadata":{"homepage_uri":"https://rubyeverywhere.com","bug_tracker_uri":"https://github.com/RubyEverywhere/gem/issues","source_code_uri":"https://github.com/RubyEverywhere/gem","rubygems_mfa_required":"true"},"yanked":false,"sha":"0c2695d95e8cf1b2c3459f3bb8efd41a1f4cbb2022baac05b21dfbdbbfc93519","spec_sha":"a42680288f334025c6dd1ecb56276a4146158ca44dc5204d561d6194e15fb618","project_uri":"https://rubygems.org/gems/ruby_everywhere","gem_uri":"https://rubygems.org/gems/ruby_everywhere-0.14.0.gem","homepage_uri":"https://rubyeverywhere.com","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/RubyEverywhere/gem","bug_tracker_uri":"https://github.com/RubyEverywhere/gem/issues","changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"base64","requirements":"~> 0.2"},{"name":"dry-cli","requirements":"~> 1.2"},{"name":"kramdown","requirements":"~> 2.5"},{"name":"rbe-tebako","requirements":"~> 0.15"},{"name":"rqrcode","requirements":"~> 3.0"}]}},"vcs_name":"GitHub","ci":null,"vcs_error":"ERROR","vcs_uri":"https://github.com/RubyEverywhere/gem"}