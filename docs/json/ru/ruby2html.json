{"gems":{"name":"ruby2html","downloads":11087,"version":"2.1.1","version_created_at":"2026-11-23T11:36:08.004Z","version_downloads":58,"platform":"ruby","ruby_abi":null,"authors":"sebi","info":"ruby2html renders HTML from a pure-Ruby block DSL (div class: \"card\" do h2 @title end). Text and attribute values are escaped by default. Works standalone, as Rails .html.rb templates and partials, inside ERB, in ViewComponent, and as lightweight Ruby2html::Component classes. Tag rendering is a C extension on CRuby, with an output-identical pure-Ruby fallback for JRuby and TruffleRuby. No runtime dependencies.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/sebyx07/ruby2html","changelog_uri":"https://github.com/sebyx07/ruby2html/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/sebyx07/ruby2html/issues","source_code_uri":"https://github.com/sebyx07/ruby2html","rubygems_mfa_required":"true"},"yanked":false,"sha":"22930237afa22178f0f56677d283e2f4dc75f0f82ead9f02758884b17d7ae9a5","spec_sha":"048f824a4d3467d978d36c4bde62cf0f760d9b8901bb785ad71021798c4a6d3c","project_uri":"https://rubygems.org/gems/ruby2html","gem_uri":"https://rubygems.org/gems/ruby2html-2.1.1.gem","homepage_uri":"https://github.com/sebyx07/ruby2html","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/sebyx07/ruby2html","bug_tracker_uri":"https://github.com/sebyx07/ruby2html/issues","changelog_uri":"https://github.com/sebyx07/ruby2html/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/sebyx07/ruby2html"}