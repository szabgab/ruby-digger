{"gems":{"name":"rubytree","downloads":5037485,"version":"2.2.3","version_created_at":"2026-10-07T18:58:59.568Z","version_downloads":22,"platform":"ruby","ruby_abi":null,"authors":"Anupam Sengupta","info":"\n    RubyTree is a Ruby implementation of the generic tree data structure. It\n    provides simple APIs to store named nodes, and to access, modify, and\n    traverse the tree.\n\n    The data model is node-centric, where nodes in the tree are the primary\n    structural elements. It supports all common tree-traversal methods (pre-order,\n    post-order, and breadth first).\n\n    RubyTree mixes in the Enumerable and Comparable modules and behaves like a\n    standard Ruby collection (iteration, comparison, etc.).\n\n    RubyTree also includes a binary tree implementation, which provides in-order\n    node traversal besides the other methods.\n\n    RubyTree can import from and export to JSON, and supports Ruby’s object\n    marshaling.\n","licenses":["BSD-2-Clause"],"metadata":{"github_repo":"ssh://github.com/evolve75/rubytree","rubygems_mfa_required":"true"},"yanked":false,"sha":"e007c42d04374b31e21ccee85d756cce0ced708131251a8d0f6c84dc9e1cbdf7","spec_sha":"97285a58ab2b9975b3a69088ab5871eeca8d0ec9441d473feb81762cfbb8747d","project_uri":"https://rubygems.org/gems/rubytree","gem_uri":"https://rubygems.org/gems/rubytree-2.2.3.gem","homepage_uri":"http://rubytree.anupamsg.me","wiki_uri":"https://github.com/evolve75/RubyTree/wiki","documentation_uri":"http://rubytree.anupamsg.me/rdoc/index.html","mailing_list_uri":"","source_code_uri":"http://github.com/evolve75/RubyTree","bug_tracker_uri":"https://github.com/evolve75/RubyTree/issues","changelog_uri":null,"funding_uri":null,"dependencies":{"development":[{"name":"awesome_bot","requirements":"~> 1.20"},{"name":"bundler-audit","requirements":"~> 0.9"},{"name":"mdl","requirements":"~> 0.14"},{"name":"rake","requirements":"~> 13.2"},{"name":"rdoc","requirements":"~> 6.10"},{"name":"rspec","requirements":"~> 3.0, >= 3.13"