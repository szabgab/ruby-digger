{"gems":{"name":"relaton","downloads":750767,"version":"3.0.0.pre.alpha.13","version_created_at":"2026-10-09T23:45:03.741Z","version_downloads":72,"platform":"ruby","ruby_abi":null,"authors":"Ribose Inc.","info":"Relaton is the database, registry, and cache for bibliographic references\nto technical standards in the Relaton/XML bibliographic model. It provides\nthe Relaton::Db API, a registry that lazily loads each standards-body\nflavor (ISO, IETF, NIST, IEC, …) on first use, and a file-based cache.\n\nEvery flavor ships inside this single gem — `gem install relaton` gives you\nthe full multi-flavor setup, with flavor code loaded on demand via autoload.\nThe CLI (relaton-cli) is a separate gem.\n","licenses":["BSD-2-Clause"],"metadata":{"rubygems_mfa_required":"true"},"yanked":false,"sha":"fb2e22a5a5d6bc6b24a15cc391e28ea1aca453d4002994b446639d27e5d666d6","spec_sha":"0932b27a21d1c7883864967f98f4420f68f3adeaa73c87adb50c473589f73f97","project_uri":"https://rubygems.org/gems/relaton","gem_uri":"https://rubygems.org/gems/relaton-3.0.0.pre.alpha.13.gem","homepage_uri":"https://github.com/relaton/relaton","wiki_uri":null,"documentation_uri":"https://www.rubydoc.info/gems/relaton/3.0.0.pre.alpha.13","mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"addressable","requirements":"~> 2.8"},{"name":"algolia","requirements":"~> 2.3.0"},{"name":"base64","requirements":">= 0"},{"name":"bibtex-ruby","requirements":">= 0"},{"name":"cnccs","requirements":"~> 0.1.1"},{"name":"concurrent-ruby","requirements":"~> 1.0"},{"name":"csv","requirements":"~> 3.3"},{"name":"faraday","requirements":"~> 2.7.0"},{"name":"faraday-net_http_persistent","requirements":"~> 2.0"},{"name":"ferrum","requirements":"~> 0.17"},{"name":"gb-agencies","requirements":"~> 0.0.1"},{"name":"graphql","requirements":"~> 2.3"},{"name":"graphql-client","requirements":"~> 0.23"},{"name":"ieee-idams","requirem