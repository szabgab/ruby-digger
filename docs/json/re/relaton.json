{"gems":{"name":"relaton","downloads":736532,"version":"3.0.0.pre.alpha.4","version_created_at":"2026-09-25T00:51:34.891Z","version_downloads":54,"platform":"ruby","ruby_abi":null,"authors":"Ribose Inc.","info":"Relaton is the database, registry, and cache for bibliographic references\nto technical standards in the Relaton/XML bibliographic model. It provides\nthe Relaton::Db API, a registry that lazily loads each standards-body\nflavor (ISO, IETF, NIST, IEC, …) on first use, and a file-based cache.\n\nEvery flavor ships inside this single gem — `gem install relaton` gives you\nthe full multi-flavor setup, with flavor code loaded on demand via autoload.\nThe CLI (relaton-cli) is a separate gem.\n","licenses":["BSD-2-Clause"],"metadata":{"rubygems_mfa_required":"true"},"yanked":false,"sha":"85e32b275daaed189753548245b049f3709a7c26c171b8fd578a48ede7504642","spec_sha":"2133715c1c3b4bbc5b237a36ef37e4e371f7cc17878dab8948c2e3d1bc5a4876","project_uri":"https://rubygems.org/gems/relaton","gem_uri":"https://rubygems.org/gems/relaton-3.0.0.pre.alpha.4.gem","homepage_uri":"https://github.com/relaton/relaton","wiki_uri":null,"documentation_uri":"https://www.rubydoc.info/gems/relaton/3.0.0.pre.alpha.4","mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"addressable","requirements":"~> 2.8"},{"name":"algolia","requirements":"~> 2.3.0"},{"name":"base64","requirements":">= 0"},{"name":"bibtex-ruby","requirements":">= 0"},{"name":"cnccs","requirements":"~> 0.1.1"},{"name":"concurrent-ruby","requirements":"~> 1.0"},{"name":"csv","requirements":"~> 3.3"},{"name":"faraday","requirements":"~> 2.7.0"},{"name":"faraday-net_http_persistent","requirements":"~> 2.0"},{"name":"ferrum","requirements":"~> 0.17"},{"name":"gb-agencies","requirements":"~> 0.0.1"},{"name":"graphql","requirements":"~> 2.3"},{"name":"graphql-client","requirements":"~> 0.23"},{"name":"ieee-idams","requirement