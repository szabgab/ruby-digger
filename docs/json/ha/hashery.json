{"gems":{"name":"hashery","downloads":108051025,"version":"2.2.2","version_created_at":"2026-11-17T21:14:08.596Z","version_downloads":739,"platform":"ruby","ruby_abi":null,"authors":"Trans, Kirk Haines, Robert Klemme, Jan Molic, George Moschovitis, Jeena Paradies, Erik Veenstra","info":"The Hashery is a tight collection of Hash-like classes. Included among its many offerings are the auto-sorting Dictionary class, the efficient LRUHash, the flexible OpenHash and the convenient KeyHash. Nearly every class is a subclass of the CRUDHash which defines a CRUD model on top of Ruby's standard Hash making it a snap to subclass and augment to fit any specific use case.","licenses":["BSD-2-Clause"],"metadata":{"homepage_uri":"https://rubyworks.github.io/hashery","changelog_uri":"https://github.com/rubyworks/hashery/blob/master/HISTORY.md","bug_tracker_uri":"https://github.com/rubyworks/hashery/issues","source_code_uri":"https://github.com/rubyworks/hashery","documentation_uri":"https://rubydoc.info/gems/hashery"},"yanked":false,"sha":"786b64d98ecb889caa854c7dc916ee016a87c817a7af0dd8d0df66bb585f19e5","spec_sha":"11d10f257a3d80c5c974a8cc5ad16bbedba97c351ce1bcb22733490b101e24fb","project_uri":"https://rubygems.org/gems/hashery","gem_uri":"https://rubygems.org/gems/hashery-2.2.2.gem","homepage_uri":"https://rubyworks.github.io/hashery","wiki_uri":null,"documentation_uri":"https://rubydoc.info/gems/hashery","mailing_list_uri":null,"source_code_uri":"https://github.com/rubyworks/hashery","bug_tracker_uri":"https://github.com/rubyworks/hashery/issues","changelog_uri":"https://github.com/rubyworks/hashery/blob/master/HISTORY.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/rubyworks/hashery"}