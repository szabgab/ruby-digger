{"gems":{"name":"hashery","downloads":108030900,"version":"2.2.1","version_created_at":"2026-11-17T18:29:26.453Z","version_downloads":366,"platform":"ruby","ruby_abi":null,"authors":"Trans, Kirk Haines, Robert Klemme, Jan Molic, George Moschovitis, Jeena Paradies, Erik Veenstra","info":"The Hashery is a tight collection of Hash-like classes. Included among its many offerings are the auto-sorting Dictionary class, the efficient LRUHash, the flexible OpenHash and the convenient KeyHash. Nearly every class is a subclass of the CRUDHash which defines a CRUD model on top of Ruby's standard Hash making it a snap to subclass and augment to fit any specific use case.","licenses":["BSD-2-Clause"],"metadata":{"homepage_uri":"https://rubyworks.github.io/hashery","changelog_uri":"https://github.com/rubyworks/hashery/blob/master/HISTORY.md","bug_tracker_uri":"https://github.com/rubyworks/hashery/issues","source_code_uri":"https://github.com/rubyworks/hashery","documentation_uri":"https://rubydoc.info/gems/hashery"},"yanked":false,"sha":"29ae7cca1f74b981fc58baaa42c8990019e7c8293b251d64430358d90b0fb316","spec_sha":"ab08e7189a7e05d77fc56b99da8a67f29d64f64473423d8ba29748b7c8449cf8","project_uri":"https://rubygems.org/gems/hashery","gem_uri":"https://rubygems.org/gems/hashery-2.2.1.gem","homepage_uri":"https://rubyworks.github.io/hashery","wiki_uri":null,"documentation_uri":"https://rubydoc.info/gems/hashery","mailing_list_uri":null,"source_code_uri":"https://github.com/rubyworks/hashery","bug_tracker_uri":"https://github.com/rubyworks/hashery/issues","changelog_uri":"https://github.com/rubyworks/hashery/blob/master/HISTORY.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/rubyworks/hashery"}