{"gems":{"name":"hypertabular","downloads":977,"version":"0.8.0","version_created_at":"2026-10-09T07:05:50.727Z","version_downloads":20,"platform":"ruby","ruby_abi":null,"authors":"Brian Buvinghausen","info":"CSV, TSV and any single-byte ASCII separator, and XLSX and ODS workbooks, read by a\nnative Rust core into typed column batches. The core owns no memory: this gem allocates the buffers once and the\ncore fills them in one native call per batch. Every cell is a HyperCast verdict — the\nvalue, or a reason plus the offending span — and a file that is not rows of cells at\nall is an exception raised after the intact rows. Two backends behind one surface,\nselected automatically and both shipped prebuilt: a Magnus extension where a precompiled\nplatform gem matches, and stdlib Fiddle everywhere else. No compile on install.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/SkunkWerkx/HyperTabular/blob/master/CHANGELOG.md","bug_tracker_uri":"https://github.com/SkunkWerkx/HyperTabular/issues","source_code_uri":"https://github.com/SkunkWerkx/HyperTabular","documentation_uri":"https://github.com/SkunkWerkx/HyperTabular/tree/master/ruby#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"df8868cd2db47a07434bf47c1b35ba23badb2577c59b745e9716114d97adcda1","spec_sha":"cd19fa9dba843ba4a6516da657067d38fd0a00aeba93ba99053680f99cad1553","project_uri":"https://rubygems.org/gems/hypertabular","gem_uri":"https://rubygems.org/gems/hypertabular-0.8.0.gem","homepage_uri":"https://github.com/SkunkWerkx/HyperTabular","wiki_uri":null,"documentation_uri":"https://github.com/SkunkWerkx/HyperTabular/tree/master/ruby#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/SkunkWerkx/HyperTabular","bug_tracker_uri":"https://github.com/SkunkWerkx/HyperTabular/issues","changelog_uri":"https://github.com/SkunkWerkx/HyperTabular/blob/master/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"rake","requirements":"~> 13.0"},{"name":"yard","requirements":"~> 0.9"}],"runtime":[{"name":"fiddle","requirements":">= 0"},{"name":"hypercast","requirements":"~> 0.8.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/SkunkWerkx/HyperTabular"}