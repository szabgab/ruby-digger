{"gems":{"name":"hypertabular","downloads":298,"version":"0.7.0","version_created_at":"2026-10-07T23:35:11.606Z","version_downloads":107,"platform":"ruby","ruby_abi":null,"authors":"Brian Buvinghausen","info":"CSV, TSV and any single-byte ASCII separator, and XLSX and ODS workbooks, read by a\nnative Rust core into typed column batches. The core owns no memory: this gem allocates the buffers once and the\ncore fills them in one native call per batch. Every cell is a HyperCast verdict — the\nvalue, or a reason plus the offending span — and a file that is not rows of cells at\nall is an exception raised after the intact rows. Two backends behind one surface,\nselected automatically and both shipped prebuilt: a Magnus extension where a precompiled\nplatform gem matches, and stdlib Fiddle everywhere else. No compile on install.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/SkunkWerkx/HyperTabular/blob/master/CHANGELOG.md","bug_tracker_uri":"https://github.com/SkunkWerkx/HyperTabular/issues","source_code_uri":"https://github.com/SkunkWerkx/HyperTabular","documentation_uri":"https://github.com/SkunkWerkx/HyperTabular/tree/master/ruby#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"bd7ae4c6b0420c52dc98f4ee7b06a3e6b4cf8092e4d2e4d49493d096ae1a1d40","spec_sha":"e0fcb459905a781884fcc42a27b134c2609b65f991662d6238261d674ad8e34c","project_uri":"https://rubygems.org/gems/hypertabular","gem_uri":"https://rubygems.org/gems/hypertabular-0.7.0.gem","homepage_uri":"https://github.com/SkunkWerkx/HyperTabular","wiki_uri":null,"documentation_uri":"https://github.com/SkunkWerkx/HyperTabular/tree/master/ruby#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/SkunkWerkx/HyperTabular","bug_tracker_uri":"https://github.com/SkunkWerkx/HyperTabular/issues","changelog_uri":"https://github.com/SkunkWerkx/HyperTabular/blob/master/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"rake","requirements":"~> 13.0"},{"name":"yard","requirements":"~> 0.9"}],"runtime":[{"name":"fiddle","requirements":">= 0"},{"name":"hypercast","requirements":"~> 0.7.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/SkunkWerkx/HyperTabular"}