{"gems":{"name":"hypertabular","downloads":2612,"version":"0.9.0","version_created_at":"2026-10-21T05:40:29.400Z","version_downloads":75,"platform":"ruby","ruby_abi":null,"authors":"Brian Buvinghausen","info":"CSV, TSV and any single-byte ASCII separator, and XLSX and ODS workbooks, read by a\nnative Rust core into typed column batches. The core owns no memory: this gem allocates the buffers once and the\ncore fills them in one native call per batch. Every cell is a HyperCast verdict — the\nvalue, or a reason plus the offending span — and a file that is not rows of cells at\nall is an exception raised after the intact rows. Two backends behind one surface,\nselected automatically and both shipped prebuilt: a Magnus extension where a precompiled\nplatform gem matches, and stdlib Fiddle everywhere else. No compile on install.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/SkunkWerkx/HyperTabular/blob/master/CHANGELOG.md","bug_tracker_uri":"https://github.com/SkunkWerkx/HyperTabular/issues","source_code_uri":"https://github.com/SkunkWerkx/HyperTabular","documentation_uri":"https://github.com/SkunkWerkx/HyperTabular/tree/master/ruby#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"2d5c2dfe2f0e8fe2a962a94618fdeddac685e7642e5931f583d5179c545ab6aa","spec_sha":"461771d0a1f127101547c0bf20cff0dd7e518a0ff4ec110bed2a150a4a9ce049","project_uri":"https://rubygems.org/gems/hypertabular","gem_uri":"https://rubygems.org/gems/hypertabular-0.9.0.gem","homepage_uri":"https://github.com/SkunkWerkx/HyperTabular","wiki_uri":null,"documentation_uri":"https://github.com/SkunkWerkx/HyperTabular/tree/master/ruby#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/SkunkWerkx/HyperTabular","bug_tracker_uri":"https://github.com/SkunkWerkx/HyperTabular/issues","changelog_uri":"https://github.com/SkunkWerkx/HyperTabular/blob/master/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"rake","requirements":"~> 13.0"},{"name":"yard","requirements":"~> 0.9"}],"runtime":[{"name":"fiddle","requirements":">= 0"},{"name":"hypercast","requirements":"~> 0.9.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/SkunkWerkx/HyperTabular"}