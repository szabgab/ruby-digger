{"gems":{"name":"lexxy-variables","downloads":3249,"version":"1.0.0","version_created_at":"2026-11-08T20:56:47.392Z","version_downloads":23,"platform":"ruby","ruby_abi":null,"authors":"Andrew Quinn","info":"Insert and safely resolve variables in Lexxy rich text. The gem gives you an\neditor button (and a `{{` prompt) for inserting variables, each stored as an\nAction Text attachment chip rather than literal markup. `with_variables`\nresolves the chips and returns plain Action Text content. Register new chip types\nwith `register_attachment`. A :text chip resolves to an escaped string, an\n:html chip splices rich content in before sanitization. Liquid is optional.\nThe default renderer is plain, injection-safe string substitution and pulls\nin no template engine.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/anquinn/lexxy-variables/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/anquinn/lexxy-variables/issues","source_code_uri":"https://github.com/anquinn/lexxy-variables"},"yanked":false,"sha":"84b1a6122806f4339550d903228acba2269fe172ebf301b2342429f05d7e2edf","spec_sha":"1e98191863a3eebcf4e623d04d25c531823ba1d5a748d369d9c53e806e0482ae","project_uri":"https://rubygems.org/gems/lexxy-variables","gem_uri":"https://rubygems.org/gems/lexxy-variables-1.0.0.gem","homepage_uri":"https://github.com/anquinn/lexxy-variables","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/anquinn/lexxy-variables","bug_tracker_uri":"https://github.com/anquinn/lexxy-variables/issues","changelog_uri":"https://github.com/anquinn/lexxy-variables/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"liquid","requirements":">= 5.0"},{"name":"minitest","requirements":">= 5.0"}],"runtime":[{"name":"actiontext","requirements":">= 8.0"},{"name":"actionview","requirements":">= 8.0"},{"name":"activesupport","requirements":">= 8.0"},{"name":"nokogiri","requirements":">= 1.15"},{"name":"railties","requirements":">= 8.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/anquinn/lexxy-variables"}