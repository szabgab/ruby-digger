{"gems":{"name":"getargv","downloads":8246,"version":"0.3.20","version_created_at":"2026-07-24T15:50:05.949Z","version_downloads":42,"platform":"universal-darwin","authors":"Camden Narzt","info":"== Getargv\nGetargv is a gem that allows you to query the arguments of other processes as an array or string.\n\nThis gem only supports macOS because the +KERN_PROCARGS2+ sysctl only exists in xnu kernels, BSD or Linux users should just read <code>/proc/$PID/cmdline</code> which is much easier and faster, Solaris users should use pargs.\n\nThis gem requires you have {libgetargv}[https://getargv.narzt.cam/] installed.\n\nTo limit the getargv gem to Apple OSs add it to your Gemfile like so:\n\n  gem \"getargv\", \"~> 0.3.20\", platforms: :ruby, install_if: RbConfig::CONFIG[\"host_os\"].include?(\"darwin\")\n","licenses":["BSD-3-Clause"],"metadata":{"funding_uri":"https://github.com/sponsors/CamJN","homepage_uri":"https://getargv.narzt.cam/","changelog_uri":"https://github.com/getargv/getargv.rb/blob/v0.3.20/CHANGELOG.md","bug_tracker_uri":"https://github.com/getargv/getargv.rb/issues","source_code_uri":"https://github.com/getargv/getargv.rb","documentation_uri":"https://rubydoc.info/gems/getargv/Getargv"},"yanked":false,"sha":"010566b1bdbe5ba07eb6142d587c8e128823b300e37e7a728a85773fcd2403a1","spec_sha":"5f783eaf9b8d76d518533b3d1aa4af49fac229c9277ee6b8067b88d69c73515e","project_uri":"https://rubygems.org/gems/getargv","gem_uri":"https://rubygems.org/gems/getargv-0.3.20-universal-darwin.gem","homepage_uri":"https://getargv.narzt.cam/","wiki_uri":null,"documentation_uri":"https://rubydoc.info/gems/getargv/Getargv","mailing_list_uri":null,"source_code_uri":"https://github.com/getargv/getargv.rb","bug_tracker_uri":"https://github.com/getargv/getargv.rb/issues","changelog_uri":"https://github.com/getargv/getargv.rb/blob/v0.3.20/CHANGELOG.md","funding_uri":"https://github.com/sponsors/CamJN","dependencies":{"development":[{"name":"bump","requirements":">= 0"},{"name":"minitest","req