{"gems":{"name":"ceedling","downloads":2371657,"version":"1.2.3","version_created_at":"2026-11-20T05:44:31.206Z","version_downloads":39,"platform":"ruby","ruby_abi":null,"authors":"Mark VanderVoord, Michael Karlesky, Greg Williams","info":"Ceedling is a build automation tool for C projects. It is especially adept at building and executing unit test suites — even for tricky embedded systems.\n\nCeedling provides three core functions:\n  [1] It packages up several tools including the C unit test framework Unity, the mock generation tool CMock, and other complementary frameworks and libraries.\n  [2] It simplifies configuration for C toolchains.\n  [3] It automates the running and reporting of test suites as well as release builds.\n\nCeedling projects start with a YAML configuration file. A variety of conventions simplify assembling suites of unit test functions and producing release builds.\n","licenses":["MIT"],"metadata":{"sbom_uri":"https://github.com/ThrowTheSwitch/Ceedling/releases/download/v1.2.3/ceedling-1.2.3.cdx.json","funding_uri":"https://github.com/sponsors/ThrowTheSwitch","homepage_uri":"https://throwtheswitch.org/ceedling","changelog_uri":"https://github.com/ThrowTheSwitch/Ceedling/blob/master/docs/Changelog.md","bug_tracker_uri":"https://github.com/ThrowTheSwitch/Ceedling/issues","source_code_uri":"https://github.com/ThrowTheSwitch/Ceedling","mailing_list_uri":"https://throwtheswitch.discourse.group","documentation_uri":"https://docs.throwtheswitch.org/Ceedling/"},"yanked":false,"sha":"9ced3c00fdb211f52aeb0b13d11f319aebdaf40a76d27eca702c776fffb71e08","spec_sha":"c8998e89d0dda7726ba68edaac2c35b2587690d776d922e37238afdcf943a26a","project_uri":"https://rubygems.org/gems/ceedling","gem_uri":"https://rubygems.org/gems/ceedling-1.2.3.gem","homepage_uri":"https://throwtheswitch.org/ceedling","wiki_uri":null,"documentation_uri":"https://docs.throwtheswitch.org/Ceedling/","mailing_list_uri":"https://throwtheswitch.discourse.group","source_code_uri":"https://git