{"gems":{"name":"rails_pod_kit","downloads":4727,"version":"0.3.0","version_created_at":"2026-07-30T21:23:30.196Z","version_downloads":0,"platform":"ruby","authors":"Fabio Napoleoni","info":"Packages the yabeda ecosystem and health-monitor-rails into a single,\nopinionated kit for running Rails applications on Kubernetes: Puma, Sidekiq\nand SolidQueue runtime metrics in Prometheus text format on an in-process\n/metrics endpoint (default port 9394), plus a /healthz endpoint wired for\nliveness/readiness/startup probes. No sidecar, no separate collector. It\nalso hosts the schedulers that let a job executor scale to zero without\nstranding its recurring jobs: a supervised SolidQueue scheduler thread, and\na supervised sidekiq-cron poller for Sidekiq.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/fabn/rails_pod_kit/releases","source_code_uri":"https://github.com/fabn/rails_pod_kit","rubygems_mfa_required":"true"},"yanked":false,"sha":"c72edfa484a2e9145762439e3e8064bf4006a474af223d1bf7ccb278d8e0b25c","spec_sha":"3b4e413014271d380672320c607a8c424d691abbc00cbf8b0ee208818fc77324","project_uri":"https://rubygems.org/gems/rails_pod_kit","gem_uri":"https://rubygems.org/gems/rails_pod_kit-0.3.0.gem","homepage_uri":"https://github.com/fabn/rails_pod_kit","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/fabn/rails_pod_kit","bug_tracker_uri":null,"changelog_uri":"https://github.com/fabn/rails_pod_kit/releases","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"anyway_config","requirements":"~> 2.0"},{"name":"concurrent-ruby","requirements":"~> 1.2"},{"name":"health-monitor-rails","requirements":"~> 12.8"},{"name":"redis","requirements":"~> 5.0"},{"name":"webrick","requirements":"~> 1.8"},{"name":"yabeda","requirements":"~> 0.16"},{"name":"yabeda-prometheus-mmap","requirements":"~> 0.4"},{"name":"yabeda-puma-plugin","requirements":"~> 0.9"},{"name":"yabeda-sidekiq","requirements":"~>