{"gems":{"name":"db-purger","downloads":31741,"version":"0.8.0","version_created_at":"2026-10-05T12:55:22.521Z","version_downloads":31,"platform":"ruby","ruby_abi":null,"authors":"Doug Youch","info":"DB Purger deletes (or soft-deletes) every row related to a single top-level record (e.g. a company or account) using a declarative Ruby purge plan. Tables are purged in primary-key batches, child tables before their parents, with plan validation against the live schema, an explain (dry-run) mode that emits SQL, and ActiveSupport::Notifications instrumentation for metrics.","licenses":["MIT"],"metadata":{"bug_tracker_uri":"https://github.com/dougyouch/db-purger/issues","source_code_uri":"https://github.com/dougyouch/db-purger","rubygems_mfa_required":"true"},"yanked":false,"sha":"a15c5657fe80ad5167076b3feeade16817601365d8ee94cb976e53abf31c7110","spec_sha":"ba0ad38a943ab9911e9cc3b0ec6c2cb43f9b9c331a26f2b20fcfa06014ba9d57","project_uri":"https://rubygems.org/gems/db-purger","gem_uri":"https://rubygems.org/gems/db-purger-0.8.0.gem","homepage_uri":"https://github.com/dougyouch/db-purger","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/dougyouch/db-purger","bug_tracker_uri":"https://github.com/dougyouch/db-purger/issues","changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activerecord","requirements":">= 7.0"},{"name":"dynamic-active-model","requirements":">= 0.9.1, < 2"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/dougyouch/db-purger"}