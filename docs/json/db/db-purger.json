{"gems":{"name":"db-purger","downloads":31397,"version":"0.7.0","version_created_at":"2026-10-01T19:42:48.053Z","version_downloads":45,"platform":"ruby","ruby_abi":null,"authors":"Doug Youch","info":"DB Purger deletes (or soft-deletes) every row related to a single top-level record (e.g. a company or account) using a declarative Ruby purge plan. Tables are purged in primary-key batches, child tables before their parents, with plan validation against the live schema, an explain (dry-run) mode that emits SQL, and ActiveSupport::Notifications instrumentation for metrics.","licenses":["MIT"],"metadata":{"bug_tracker_uri":"https://github.com/dougyouch/db-purger/issues","source_code_uri":"https://github.com/dougyouch/db-purger","rubygems_mfa_required":"true"},"yanked":false,"sha":"1e76796c4aaf6cbe59d1e2d1ed59fd1af86aac1099d7eb0db3d1db7a4d2eb45f","spec_sha":"6d703609d80ce0d0eebd7fd1ea027994a9fdcd6e323ac8168d302bbc9cac0e20","project_uri":"https://rubygems.org/gems/db-purger","gem_uri":"https://rubygems.org/gems/db-purger-0.7.0.gem","homepage_uri":"https://github.com/dougyouch/db-purger","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/dougyouch/db-purger","bug_tracker_uri":"https://github.com/dougyouch/db-purger/issues","changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activerecord","requirements":">= 7.0"},{"name":"dynamic-active-model","requirements":"~> 0.9, >= 0.9.1"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/dougyouch/db-purger"}