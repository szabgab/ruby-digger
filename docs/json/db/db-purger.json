{"gems":{"name":"db-purger","downloads":31224,"version":"0.6.0","version_created_at":"2026-10-01T15:36:48.385Z","version_downloads":79,"platform":"ruby","ruby_abi":null,"authors":"Doug Youch","info":"DB Purger deletes (or soft-deletes) every row related to a single top-level record (e.g. a company or account) using a declarative Ruby purge plan. Tables are purged in primary-key batches, child tables before their parents, with plan validation against the live schema, an explain (dry-run) mode that emits SQL, and ActiveSupport::Notifications instrumentation for metrics.","licenses":["MIT"],"metadata":{"bug_tracker_uri":"https://github.com/dougyouch/db-purger/issues","source_code_uri":"https://github.com/dougyouch/db-purger","rubygems_mfa_required":"true"},"yanked":false,"sha":"d38eeb89aea51307fcbbdb8b07177d72187676a011a547d3cbeaf631912701da","spec_sha":"cc92da7ab7ab12c01335e76ef5f9dcb791a1eb8c5fc9280ebc122e5ab2fa1e1b","project_uri":"https://rubygems.org/gems/db-purger","gem_uri":"https://rubygems.org/gems/db-purger-0.6.0.gem","homepage_uri":"https://github.com/dougyouch/db-purger","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/dougyouch/db-purger","bug_tracker_uri":"https://github.com/dougyouch/db-purger/issues","changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activerecord","requirements":">= 7.0"},{"name":"dynamic-active-model","requirements":"~> 0.9, >= 0.9.1"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/dougyouch/db-purger"}