{"gems":{"name":"cocoapods-local-override","downloads":2065,"version":"1.0.1","version_created_at":"2026-08-24T09:29:56.288Z","version_downloads":89,"platform":"ruby","authors":"zhaocw","info":"    自动读取项目根目录下的 Podfile.local (YAML 格式)，\n    在不修改 Podfile 的情况下，将指定的 pod 从远程依赖切换为本地路径依赖。\n    也支持替换版本号和 git 分支。\n\n    Podfile.local 示例：\n    local_pods:\n      SomePod: ../path/to/SomePod\n      AnotherPod: ../path/to/AnotherPod\n    replace_versions:\n      SomePod: 1.2.3\n    replace_branches:\n      SomePod: develop\n","licenses":["MIT"],"metadata":{},"yanked":false,"sha":"3b17ef2e5945d11fc1fb6654898e7aea6ad27d3116dbbf3104ba47934afe14ee","spec_sha":"f653883df67504bc63ac6d295a1341e71e6bf8b2a2f4f295cbb12d6900270b6b","project_uri":"https://rubygems.org/gems/cocoapods-local-override","gem_uri":"https://rubygems.org/gems/cocoapods-local-override-1.0.1.gem","homepage_uri":"https://github.com/charleszhao888888/cocoapods-local-override","wiki_uri":null,"documentation_uri":"https://www.rubydoc.info/gems/cocoapods-local-override/1.0.1","mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/charleszhao888888/cocoapods-local-override"}