{"gems":{"name":"autogui","downloads":185,"version":"1.0.1","version_created_at":"2026-09-04T06:11:37.221Z","version_downloads":0,"platform":"ruby","ruby_abi":null,"authors":"pardeep2690","info":"AutoGUI controls the mouse and keyboard, takes screenshots, finds images on\nthe screen, shows message boxes, and inspects application windows. It is a\nRuby port of Python PyAutoGUI with snake_case methods and CamelCase aliases.\n\nWindows talks to the Win32 API through Ruby's standard-library Fiddle\n(no extra gems). macOS uses osascript and screencapture. Linux uses\nxdotool plus scrot, ImageMagick, or grim.\n\nFail-safe: moving the cursor into a screen corner raises FailSafeException.\n","licenses":["BSD-3-Clause"],"metadata":{"homepage_uri":"https://github.com/pardeep2690/autogui","changelog_uri":"https://github.com/pardeep2690/autogui/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/pardeep2690/autogui/issues","source_code_uri":"https://github.com/pardeep2690/autogui","allowed_push_host":"https://rubygems.org","documentation_uri":"https://github.com/pardeep2690/autogui#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"b94b6d30babaa0b48634c8c5cd9385638504435b2c26b1708be43ba10f0eb493","spec_sha":"5b530ed60d13c486b3388ab10b2ac405d91c0892d877305bb513c4f95a1e5c60","project_uri":"https://rubygems.org/gems/autogui","gem_uri":"https://rubygems.org/gems/autogui-1.0.1.gem","homepage_uri":"https://github.com/pardeep2690/autogui","wiki_uri":null,"documentation_uri":"https://github.com/pardeep2690/autogui#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/pardeep2690/autogui","bug_tracker_uri":"https://github.com/pardeep2690/autogui/issues","changelog_uri":"https://github.com/pardeep2690/autogui/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/pardeep2690/autogui"}