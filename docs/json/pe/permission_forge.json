{"gems":{"name":"permission_forge","downloads":395,"version":"0.15.0","version_created_at":"2026-10-19T12:37:23.361Z","version_downloads":70,"platform":"ruby","ruby_abi":null,"authors":"Feti Jashari","info":"PermissionForge stores permissions as Permission Sets that admins edit at runtime: per-model CRUD flags and custom actions, per-field read/edit access with masking, and row-level query rules. It applies them in your models (find_by, permission_scoped, attribute readers and serialization) and controllers, caches each user's permissions in any Rails cache store, records every permission change in an audit log, and ships an admin UI and an opt-in JSON admin API.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/fetijashari/permission_forge/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/fetijashari/permission_forge/issues","source_code_uri":"https://github.com/fetijashari/permission_forge","documentation_uri":"https://github.com/fetijashari/permission_forge/tree/main/docs","rubygems_mfa_required":"true"},"yanked":false,"sha":"b7500a29fed4f387c43cd2df6708c4733e5b50de6b275c62c4d1b9ac9ea1955f","spec_sha":"5abd30153248baf6fb0034970f5533fe74914d850758f52861968c5403a7a44e","project_uri":"https://rubygems.org/gems/permission_forge","gem_uri":"https://rubygems.org/gems/permission_forge-0.15.0.gem","homepage_uri":"https://github.com/fetijashari/permission_forge","wiki_uri":null,"documentation_uri":"https://github.com/fetijashari/permission_forge/tree/main/docs","mailing_list_uri":null,"source_code_uri":"https://github.com/fetijashari/permission_forge","bug_tracker_uri":"https://github.com/fetijashari/permission_forge/issues","changelog_uri":"https://github.com/fetijashari/permission_forge/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activerecord","requirements":">= 7.1, < 8.2"},{"name":"activesupport","requirements":">= 7.1, < 8.2"},{"name":"railties","requirements":">= 7.1, < 8.2"}]}},"vcs_n