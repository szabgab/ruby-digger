{"gems":{"name":"pdfrb","downloads":20763,"version":"0.8.3","version_created_at":"2026-08-28T04:30:00.933Z","version_downloads":11,"platform":"ruby","ruby_abi":null,"authors":"Ribose Inc.","info":"Pdfrb is a pure-Ruby PDF library: a byte-level reader, an\nArlington-model-driven typed domain model, and a serializer. The\nPDF object model is sourced directly from the vendored Arlington\nPDF Model TSVs (machine-readable ISO 32000-2:2020), so field\nmetadata, version predicates, and validators stay aligned with\nthe spec by data, not by hand-coded mimicry.\n\nTwo-direction contract: \"PDF file <=> Model\" and \"API Builder\nInput => Model\". Mirrors the layered design of the sibling\npostscript gem.\n","licenses":["BSD-2-Clause"],"metadata":{"homepage_uri":"https://github.com/claricle/pdfrb","changelog_uri":"https://github.com/claricle/pdfrb/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/claricle/pdfrb/issues","source_code_uri":"https://github.com/claricle/pdfrb","rubygems_mfa_required":"true"},"yanked":false,"sha":"624d354ecf13791265fb74d2540507dd66c9aa9fe7dc1512a622cc580249434e","spec_sha":"b64e464cacd34787c4ed28838c4ef7a87a73057a17a62b1f68b246bb6715e745","project_uri":"https://rubygems.org/gems/pdfrb","gem_uri":"https://rubygems.org/gems/pdfrb-0.8.3.gem","homepage_uri":"https://github.com/claricle/pdfrb","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/claricle/pdfrb","bug_tracker_uri":"https://github.com/claricle/pdfrb/issues","changelog_uri":"https://github.com/claricle/pdfrb/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"benchmark","requirements":"~> 0.4"},{"name":"logger","requirements":"~> 1.6"},{"name":"rexml","requirements":"~> 3.3"},{"name":"thor","requirements":">= 0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/claricle/pdfrb"}