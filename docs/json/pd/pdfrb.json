{"gems":{"name":"pdfrb","downloads":21704,"version":"0.8.4","version_created_at":"2026-08-29T02:27:15.215Z","version_downloads":116,"platform":"ruby","ruby_abi":null,"authors":"Ribose Inc.","info":"Pdfrb is a pure-Ruby PDF library: a byte-level reader, an\nArlington-model-driven typed domain model, and a serializer. The\nPDF object model is sourced directly from the vendored Arlington\nPDF Model TSVs (machine-readable ISO 32000-2:2020), so field\nmetadata, version predicates, and validators stay aligned with\nthe spec by data, not by hand-coded mimicry.\n\nTwo-direction contract: \"PDF file <=> Model\" and \"API Builder\nInput => Model\". Mirrors the layered design of the sibling\npostscript gem.\n","licenses":["BSD-2-Clause"],"metadata":{"homepage_uri":"https://github.com/claricle/pdfrb","changelog_uri":"https://github.com/claricle/pdfrb/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/claricle/pdfrb/issues","source_code_uri":"https://github.com/claricle/pdfrb","rubygems_mfa_required":"true"},"yanked":false,"sha":"06165f2d616d537886b1baefb91118a5ba826f33345679635dadd7c4d44025b4","spec_sha":"3e76c4660254418d9f9fe5af261b958495e7ba9e9ee9a0fbd30570e42bf8f3b1","project_uri":"https://rubygems.org/gems/pdfrb","gem_uri":"https://rubygems.org/gems/pdfrb-0.8.4.gem","homepage_uri":"https://github.com/claricle/pdfrb","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/claricle/pdfrb","bug_tracker_uri":"https://github.com/claricle/pdfrb/issues","changelog_uri":"https://github.com/claricle/pdfrb/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"benchmark","requirements":"~> 0.4"},{"name":"logger","requirements":"~> 1.6"},{"name":"rexml","requirements":"~> 3.3"},{"name":"thor","requirements":">= 0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/claricle/pdfrb"}