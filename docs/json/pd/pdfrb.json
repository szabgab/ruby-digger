{"gems":{"name":"pdfrb","downloads":8390,"version":"0.7.19","version_created_at":"2026-08-17T01:21:42.684Z","version_downloads":12,"platform":"ruby","authors":"Ribose Inc.","info":"Pdfrb is a pure-Ruby PDF library: a byte-level reader, an\nArlington-model-driven typed domain model, and a serializer. The\nPDF object model is sourced directly from the vendored Arlington\nPDF Model TSVs (machine-readable ISO 32000-2:2020), so field\nmetadata, version predicates, and validators stay aligned with\nthe spec by data, not by hand-coded mimicry.\n\nTwo-direction contract: \"PDF file <=> Model\" and \"API Builder\nInput => Model\". Mirrors the layered design of the sibling\npostscript gem.\n","licenses":["BSD-2-Clause"],"metadata":{"homepage_uri":"https://github.com/claricle/pdfrb","changelog_uri":"https://github.com/claricle/pdfrb/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/claricle/pdfrb/issues","source_code_uri":"https://github.com/claricle/pdfrb","rubygems_mfa_required":"true"},"yanked":false,"sha":"8b0069b9a563fecfa5c49914a8fe1485041a98da1c0dcad643f25ee44d542f50","spec_sha":"e952ed28877182d68e900cd99e6415860d5698ac075871ba9bef524aa8e9c360","project_uri":"https://rubygems.org/gems/pdfrb","gem_uri":"https://rubygems.org/gems/pdfrb-0.7.19.gem","homepage_uri":"https://github.com/claricle/pdfrb","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/claricle/pdfrb","bug_tracker_uri":"https://github.com/claricle/pdfrb/issues","changelog_uri":"https://github.com/claricle/pdfrb/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"thor","requirements":">= 0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/claricle/pdfrb"}