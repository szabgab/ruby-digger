{"gems":{"name":"pdfrb","downloads":14158,"version":"0.7.37","version_created_at":"2026-08-24T05:02:47.947Z","version_downloads":16,"platform":"ruby","authors":"Ribose Inc.","info":"Pdfrb is a pure-Ruby PDF library: a byte-level reader, an\nArlington-model-driven typed domain model, and a serializer. The\nPDF object model is sourced directly from the vendored Arlington\nPDF Model TSVs (machine-readable ISO 32000-2:2020), so field\nmetadata, version predicates, and validators stay aligned with\nthe spec by data, not by hand-coded mimicry.\n\nTwo-direction contract: \"PDF file <=> Model\" and \"API Builder\nInput => Model\". Mirrors the layered design of the sibling\npostscript gem.\n","licenses":["BSD-2-Clause"],"metadata":{"homepage_uri":"https://github.com/claricle/pdfrb","changelog_uri":"https://github.com/claricle/pdfrb/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/claricle/pdfrb/issues","source_code_uri":"https://github.com/claricle/pdfrb","rubygems_mfa_required":"true"},"yanked":false,"sha":"65b42c7dacce041dd63a15c09141be1934fbccaa44bff4350db03292685a0cfc","spec_sha":"d306c4d8b95e7c05d390b4766f3214cd12f8ffd385ea3d5dbc5b141a6701c5b9","project_uri":"https://rubygems.org/gems/pdfrb","gem_uri":"https://rubygems.org/gems/pdfrb-0.7.37.gem","homepage_uri":"https://github.com/claricle/pdfrb","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/claricle/pdfrb","bug_tracker_uri":"https://github.com/claricle/pdfrb/issues","changelog_uri":"https://github.com/claricle/pdfrb/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"thor","requirements":">= 0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/claricle/pdfrb"}