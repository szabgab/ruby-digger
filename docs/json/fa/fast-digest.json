{"gems":{"name":"fast-digest","downloads":397,"version":"0.1.2","version_created_at":"2026-11-27T22:34:15.608Z","version_downloads":74,"platform":"ruby","ruby_abi":null,"authors":"Eric Jacobs","info":"Fast::Digest implements RFC 9530 Digest Fields — the four integrity\nfields as frozen value objects over fast-sfv: ContentDigest and\nReprDigest (algorithm key => digest Byte Sequence) with the\nfail-closed recipient semantics of RFC 9651 2.2, and\nWantContentDigest and WantReprDigest (algorithm key => Integer\n0..10 preference). The hash-algorithm registry of RFC 9530 7.2\nTable 2 as frozen data with unknown-key passthrough, and digest\ncomputing over the stdlib digest library for sha-256, sha-512, md5\nand sha. One runtime dependency, fast-sfv.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/jetpks/fast-http-fields","changelog_uri":"https://github.com/jetpks/fast-http-fields/blob/main/gems/digest/CHANGELOG.md","source_code_uri":"https://github.com/jetpks/fast-http-fields","documentation_uri":"https://github.com/jetpks/fast-http-fields/tree/main/gems/digest/docs","rubygems_mfa_required":"true"},"yanked":false,"sha":"d34437fcb963678de695e714e0de6cdb3ff62efad94d040472aafe6bff7ab7d5","spec_sha":"44bda021685a8a6a7546ba4a205809dea1a8ae75e4a409cd60d8e1e4034b2f24","project_uri":"https://rubygems.org/gems/fast-digest","gem_uri":"https://rubygems.org/gems/fast-digest-0.1.2.gem","homepage_uri":"https://github.com/jetpks/fast-http-fields","wiki_uri":null,"documentation_uri":"https://github.com/jetpks/fast-http-fields/tree/main/gems/digest/docs","mailing_list_uri":null,"source_code_uri":"https://github.com/jetpks/fast-http-fields","bug_tracker_uri":null,"changelog_uri":"https://github.com/jetpks/fast-http-fields/blob/main/gems/digest/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"fast-sfv","requirements":"~> 0.2"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/jetpks/fast-http-fields"}