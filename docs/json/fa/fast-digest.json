{"gems":{"name":"fast-digest","downloads":247,"version":"0.1.1","version_created_at":"2026-11-27T05:33:02.626Z","version_downloads":74,"platform":"ruby","ruby_abi":null,"authors":"Eric Jacobs","info":"Fast::Digest implements RFC 9530 Digest Fields — the four integrity\nfields as frozen value objects over fast-sfv: ContentDigest and\nReprDigest (algorithm key => digest Byte Sequence) with the\nfail-closed recipient semantics of RFC 9651 2.2, and\nWantContentDigest and WantReprDigest (algorithm key => Integer\n0..10 preference). The hash-algorithm registry of RFC 9530 7.2\nTable 2 as frozen data with unknown-key passthrough, and digest\ncomputing over the stdlib digest library for sha-256, sha-512, md5\nand sha. One runtime dependency, fast-sfv.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/jetpks/fast-http-fields","changelog_uri":"https://github.com/jetpks/fast-http-fields/blob/main/gems/digest/CHANGELOG.md","source_code_uri":"https://github.com/jetpks/fast-http-fields","documentation_uri":"https://github.com/jetpks/fast-http-fields/tree/main/gems/digest/docs","rubygems_mfa_required":"true"},"yanked":false,"sha":"4d5369bd9920bf0a6e43286bbe25d2d8012e88affa19eee27ba12688523c857f","spec_sha":"3a76e018fcbe110740f620525499fb0e948ec3eed9097cfc8b6e6b30af01638d","project_uri":"https://rubygems.org/gems/fast-digest","gem_uri":"https://rubygems.org/gems/fast-digest-0.1.1.gem","homepage_uri":"https://github.com/jetpks/fast-http-fields","wiki_uri":null,"documentation_uri":"https://github.com/jetpks/fast-http-fields/tree/main/gems/digest/docs","mailing_list_uri":null,"source_code_uri":"https://github.com/jetpks/fast-http-fields","bug_tracker_uri":null,"changelog_uri":"https://github.com/jetpks/fast-http-fields/blob/main/gems/digest/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"fast-sfv","requirements":"~> 0.2"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/jetpks/fast-http-fields"}