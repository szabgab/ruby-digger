{"gems":{"name":"grx-tensor","downloads":289,"version":"0.2.0","version_created_at":"2026-08-22T02:23:36.963Z","version_downloads":64,"platform":"ruby","authors":"Razo","info":"GRX brings PyTorch-style tensor operations to Ruby. Every arithmetic op,\nactivation, and optimizer step runs through a native C library compiled\nwith AVX2+FMA SIMD. Ruby is the interface — C does the work.\n\nFeatures: autograd, SGD/Adam optimizers, Linear/Sequential/Dropout/BatchNorm\nlayers, MSE/BCE/CrossEntropy loss functions, Xavier and He weight init.\nCross-platform: .so on Linux, .dylib on macOS, .dll on Windows.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/Gabo-Razo/grx-tensor","changelog_uri":"https://github.com/Gabo-Razo/grx-tensor/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/Gabo-Razo/grx-tensor/issues"},"yanked":false,"sha":"7accc91a6f004101287c9ae164d6d25c640cced492723eab1ea1bcd59a19ad9c","spec_sha":"763e4a98170a11ca4ea77a363e0b1e18fead8e8cdb5a619c12411238ac00907d","project_uri":"https://rubygems.org/gems/grx-tensor","gem_uri":"https://rubygems.org/gems/grx-tensor-0.2.0.gem","homepage_uri":"https://github.com/Gabo-Razo/grx-tensor","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":"https://github.com/Gabo-Razo/grx-tensor/issues","changelog_uri":"https://github.com/Gabo-Razo/grx-tensor/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"bundler","requirements":"~> 2.0"},{"name":"minitest","requirements":"~> 5.0"},{"name":"rake","requirements":"~> 13.0"},{"name":"rake-compiler","requirements":"~> 1.2"}],"runtime":[]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/Gabo-Razo/grx-tensor"}