{"gems":{"name":"grx-tensor","downloads":602,"version":"0.2.1","version_created_at":"2026-08-30T02:36:47.114Z","version_downloads":191,"platform":"ruby","ruby_abi":null,"authors":"Razo","info":"GRX brings PyTorch-style tensor operations to Ruby. Every arithmetic op,\nactivation, and optimizer step runs through a native C library with\ndynamic multi-target SIMD dispatch (AVX2+FMA, SSE, and scalar fallback).\nRuby is the interface — C does the work.\n\nFeatures: autograd, SGD/Adam optimizers, Linear/Sequential/Dropout/BatchNorm\nlayers, MSE/BCE/CrossEntropy loss functions, Xavier and He weight init.\nCross-platform: .so on Linux, .dylib on macOS, .dll on Windows.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/Gabo-Razo/grx-tensor","changelog_uri":"https://github.com/Gabo-Razo/grx-tensor/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/Gabo-Razo/grx-tensor/issues"},"yanked":false,"sha":"262798e5cb3f8d12fd66a6ad313421a48e0ed709ceb9f2770172c0e666cc8103","spec_sha":"c6c8deabc1a79ef9c708f56fbaee764d9751d639be986f1412556ca4d7e0cf99","project_uri":"https://rubygems.org/gems/grx-tensor","gem_uri":"https://rubygems.org/gems/grx-tensor-0.2.1.gem","homepage_uri":"https://github.com/Gabo-Razo/grx-tensor","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":"https://github.com/Gabo-Razo/grx-tensor/issues","changelog_uri":"https://github.com/Gabo-Razo/grx-tensor/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"bundler","requirements":"~> 2.0"},{"name":"minitest","requirements":"~> 5.0"},{"name":"rake","requirements":"~> 13.0"},{"name":"rake-compiler","requirements":"~> 1.2"}],"runtime":[]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/Gabo-Razo/grx-tensor"}