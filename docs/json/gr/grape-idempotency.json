{"gems":{"name":"grape-idempotency","downloads":18620,"version":"1.2.0","version_created_at":"2026-10-15T13:28:17.374Z","version_downloads":67,"platform":"ruby","ruby_abi":null,"authors":"Juan Carlos García","info":"Idempotency-Key header support for Grape REST APIs, based on the IETF Idempotency-Key HTTP header draft. Wrap a POST or PATCH endpoint in an idempotent block and clients can safely retry requests after timeouts or network errors without creating duplicate payments, orders or records. The first response (status, headers and body) is stored in Redis and replayed for retries with the same key. Concurrent duplicate requests get a 409 Conflict, and reusing a key with a different payload gets a 422 Unprocessable Entity. Works with Grape 1.x to 4.x and Ruby 2.6+.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/jcagarcia/grape-idempotency","changelog_uri":"https://github.com/jcagarcia/grape-idempotency/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/jcagarcia/grape-idempotency/issues","source_code_uri":"https://github.com/jcagarcia/grape-idempotency","documentation_uri":"https://github.com/jcagarcia/grape-idempotency#readme"},"yanked":false,"sha":"cc708a1e113ff667d57d4d971d00151dc5375f542cb6d8a72594ae20a37825fb","spec_sha":"ceef375edfc243b88350a1a549883c44832a56dfddbdda6a1ae022c3f8d3ba43","project_uri":"https://rubygems.org/gems/grape-idempotency","gem_uri":"https://rubygems.org/gems/grape-idempotency-1.2.0.gem","homepage_uri":"https://github.com/jcagarcia/grape-idempotency","wiki_uri":null,"documentation_uri":"https://github.com/jcagarcia/grape-idempotency#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/jcagarcia/grape-idempotency","bug_tracker_uri":"https://github.com/jcagarcia/grape-idempotency/issues","changelog_uri":"https://github.com/jcagarcia/grape-idempotency/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"bundler","requirements":">= 0"},{"name":"mock_redis","requi