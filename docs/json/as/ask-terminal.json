{"gems":{"name":"ask-terminal","downloads":2019,"version":"0.2.2","version_created_at":"2026-09-22T19:04:59.687Z","version_downloads":0,"platform":"ruby","ruby_abi":null,"authors":"Kaka Ruto","info":"The first thin client of the ask ecosystem: an interactive terminal coding agent that speaks the canonical ask-session-protocol and nothing else. Spawns the host (ask-app-server) over stdio or attaches to a running host over its unix socket — the same protocol any other client (web console, bots) speaks, so multiple clients can share the same live sessions.","licenses":["MIT"],"metadata":{},"yanked":false,"sha":"45b811c5510aa3bbd9a315857073ec4a52db3a668128fcdf2e2e624df61c2355","spec_sha":"aa138fa3a76485fbab9cee23866a92b7ee3e81d04381df2deee5f69a4a1079df","project_uri":"https://rubygems.org/gems/ask-terminal","gem_uri":"https://rubygems.org/gems/ask-terminal-0.2.2.gem","homepage_uri":"https://github.com/ask-rb/ask-terminal","wiki_uri":null,"documentation_uri":"https://www.rubydoc.info/gems/ask-terminal/0.2.2","mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[{"name":"minitest","requirements":"~> 5.25"},{"name":"mocha","requirements":"~> 3.1"},{"name":"rake","requirements":"~> 13.0"},{"name":"simplecov","requirements":"~> 0.22"}],"runtime":[{"name":"ask-session-protocol","requirements":">= 0.2.1"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/ask-rb/ask-terminal"}