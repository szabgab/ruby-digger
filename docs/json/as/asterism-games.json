{"gems":{"name":"asterism-games","downloads":592,"version":"0.20.0","version_created_at":"2026-10-20T12:57:09.569Z","version_downloads":14,"platform":"ruby","ruby_abi":null,"authors":"Katsuhiko Kageyama","info":"A framework for the server side of a game on an Asterism network: the host (tables exposed as Asterism objects, the state put and saved, who is there, time), the rooms of an Asterism console and the permanent tables next to them. A game subclasses AsterismGames::Game and AsterismGames::Remote and writes only its rules and the methods it exposes. Comes with othello and a shared drawing board as samples, terminal clients for othello and mahjong (asterism-games play), and a mahjong commentator that draws a table in the browser (asterism-games commentate).","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/ruby-asterism/asterism-games","changelog_uri":"https://github.com/ruby-asterism/asterism-games/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/ruby-asterism/asterism-games/issues","source_code_uri":"https://github.com/ruby-asterism/asterism-games","rubygems_mfa_required":"true"},"yanked":false,"sha":"09a356c1521839537a96b37172f591fe10caa0a43dc41ad5de5eb11b51f6eb4e","spec_sha":"05afc19e4515fe9f390378d8c3c8bee7b9d367bea9efccdbe221b06607e990fd","project_uri":"https://rubygems.org/gems/asterism-games","gem_uri":"https://rubygems.org/gems/asterism-games-0.20.0.gem","homepage_uri":"https://github.com/ruby-asterism/asterism-games","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/ruby-asterism/asterism-games","bug_tracker_uri":"https://github.com/ruby-asterism/asterism-games/issues","changelog_uri":"https://github.com/ruby-asterism/asterism-games/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"asterism","requirements":"~> 0.7, >= 0.7.1"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/ruby-asterism/asterism-