{"gems":{"name":"asterism-games","downloads":550,"version":"0.19.1","version_created_at":"2026-10-20T11:21:46.625Z","version_downloads":71,"platform":"ruby","ruby_abi":null,"authors":"Katsuhiko Kageyama","info":"A framework for the server side of a game on an Asterism network: the host (tables exposed as Asterism objects, the state put and saved, who is there, time), the rooms of an Asterism console and the permanent tables next to them. A game subclasses AsterismGames::Game and AsterismGames::Remote and writes only its rules and the methods it exposes. Comes with othello and a shared drawing board as samples, terminal clients for othello and mahjong (asterism-games play), and a mahjong commentator that draws a table in the browser (asterism-games commentate).","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/ruby-asterism/asterism-games","changelog_uri":"https://github.com/ruby-asterism/asterism-games/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/ruby-asterism/asterism-games/issues","source_code_uri":"https://github.com/ruby-asterism/asterism-games","rubygems_mfa_required":"true"},"yanked":false,"sha":"1b3567406c81490db04b0caaf63d9f2d3b88148423f710b0bf3514ed08c02c4c","spec_sha":"e0690711affd6850825028f4f36fec6584ac2e2e37fad95f729811b33ab8c555","project_uri":"https://rubygems.org/gems/asterism-games","gem_uri":"https://rubygems.org/gems/asterism-games-0.19.1.gem","homepage_uri":"https://github.com/ruby-asterism/asterism-games","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/ruby-asterism/asterism-games","bug_tracker_uri":"https://github.com/ruby-asterism/asterism-games/issues","changelog_uri":"https://github.com/ruby-asterism/asterism-games/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"asterism","requirements":"~> 0.7, >= 0.7.1"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/ruby-asterism/asterism-