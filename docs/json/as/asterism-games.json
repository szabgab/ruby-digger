{"gems":{"name":"asterism-games","downloads":1471,"version":"0.23.0","version_created_at":"2026-11-13T17:00:48.093Z","version_downloads":0,"platform":"ruby","ruby_abi":null,"authors":"Katsuhiko Kageyama","info":"A framework for the server side of a game on an Asterism network: the host (tables exposed as Asterism objects, the state put and saved, who is there, time), the rooms of an Asterism console and the permanent tables next to them. A game subclasses AsterismGames::Game and AsterismGames::Remote and writes only its rules and the methods it exposes. Comes with othello and a shared drawing board as samples, terminal clients for othello and mahjong (asterism-games play), and a mahjong commentator that draws a table in the browser (asterism-games commentate).","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/ruby-asterism/asterism-games","changelog_uri":"https://github.com/ruby-asterism/asterism-games/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/ruby-asterism/asterism-games/issues","source_code_uri":"https://github.com/ruby-asterism/asterism-games","rubygems_mfa_required":"true"},"yanked":false,"sha":"f5a9b0701223bfc9447d4fd61e44d3dc3c20be56299d1aafa6da7de6310cc9c5","spec_sha":"0d68435183f96be12a162cc641ffb5dc56ffb1ac35cae69af32c0cc543ed1f52","project_uri":"https://rubygems.org/gems/asterism-games","gem_uri":"https://rubygems.org/gems/asterism-games-0.23.0.gem","homepage_uri":"https://github.com/ruby-asterism/asterism-games","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/ruby-asterism/asterism-games","bug_tracker_uri":"https://github.com/ruby-asterism/asterism-games/issues","changelog_uri":"https://github.com/ruby-asterism/asterism-games/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"asterism","requirements":"~> 0.14"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/ruby-asterism/asterism-games"}