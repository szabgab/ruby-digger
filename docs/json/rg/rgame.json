{"gems":{"name":"rgame","downloads":3407,"version":"0.4.0","version_created_at":"2026-09-16T14:09:51.326Z","version_downloads":116,"platform":"ruby","ruby_abi":null,"authors":"Paul Süßenbach","info":"RGame is a small 2D game engine for Ruby, written in Ruby and C. It's build\non top of SDL2, OpenGL and miniaudio. It's built with testability and\nperformance in mind, and aims to be an engine where you can write your whole\ngame code in Ruby, test it as usual with RSpec (or Minitest, or another test\nframework) and still have acceptable performance.\n\nWhile still a work in progress, RGame aims to be more than a SDL/OpenGL\nbinding - it ships with high level features like a scene graph, sprites,\ncollision systems, debugging tools and an UI toolkit.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/psuessenb/rgame/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/psuessenb/rgame/issues","source_code_uri":"https://github.com/psuessenb/rgame","documentation_uri":"https://github.com/psuessenb/rgame/blob/main/docs/api/README.md","rubygems_mfa_required":"true"},"yanked":false,"sha":"cf2917950ca138a70326a2f22dbe67986a3b7d6178232780e7364d66bba4d7a9","spec_sha":"2aa53964a944f38fc0f5bdb21e551545fb8fcb5fba2889eeefb74c18b9e6a8ef","project_uri":"https://rubygems.org/gems/rgame","gem_uri":"https://rubygems.org/gems/rgame-0.4.0.gem","homepage_uri":"https://github.com/psuessenb/rgame","wiki_uri":null,"documentation_uri":"https://github.com/psuessenb/rgame/blob/main/docs/api/README.md","mailing_list_uri":null,"source_code_uri":"https://github.com/psuessenb/rgame","bug_tracker_uri":"https://github.com/psuessenb/rgame/issues","changelog_uri":"https://github.com/psuessenb/rgame/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"rexml","requirements":"~> 3.4"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/psuessenb/rgame"}