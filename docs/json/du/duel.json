{"gems":{"name":"duel","downloads":4427,"version":"0.1.5","version_created_at":"2026-11-08T23:51:57.372Z","version_downloads":111,"platform":"ruby","ruby_abi":null,"authors":"Erik Berlin","info":"Duel runs your benchmarks on two versions of your code side by side, the baseline (where your branch left main, say) and the candidate, and fails if the candidate is slower at any of them. Timings are judged by a distribution-free confidence interval for paired CPU-time ratios and confirmed in fresh processes, so it fails on real regressions, not noise.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/sferik/duel-ruby/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/sferik/duel-ruby/issues","source_code_uri":"https://github.com/sferik/duel-ruby","rubygems_mfa_required":"true"},"yanked":false,"sha":"8064dd610dce31bc34426104a2d5098612b4b3b124dd9a7e1803c0804006a1d6","spec_sha":"0f9dc89f7c68221daaf5a9cd7b6d5244860b2bc7ade508df96662758a776afb8","project_uri":"https://rubygems.org/gems/duel","gem_uri":"https://rubygems.org/gems/duel-0.1.5.gem","homepage_uri":"https://github.com/sferik/duel-ruby","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/sferik/duel-ruby","bug_tracker_uri":"https://github.com/sferik/duel-ruby/issues","changelog_uri":"https://github.com/sferik/duel-ruby/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"fiddle","requirements":"~> 1.1"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/sferik/duel-ruby"}