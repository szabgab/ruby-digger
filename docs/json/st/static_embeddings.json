{"gems":{"name":"static_embeddings","downloads":5093,"version":"0.1.5","version_created_at":"2026-09-01T18:03:55.161Z","version_downloads":1,"platform":"ruby","ruby_abi":null,"authors":"Roman Haydarov","info":"A small C-extension runtime for Model2Vec-style static embedding models. Models are converted offline into a flat mmap-able .semb file; at runtime the gem tokenizes (BERT WordPiece), looks up rows and mean-pools them. Releases the GVL on large native work, rejects internal thread fan-out, and links nothing but libc.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/roman-haidarov/static_embeddings","changelog_uri":"https://github.com/roman-haidarov/static_embeddings/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/roman-haidarov/static_embeddings"},"yanked":false,"sha":"92f093242f171a3f75d6ca1d5272ac190bab0f2e0659c671832d40a8d4609b9d","spec_sha":"2b1bf7311286bc9c7df2906d073c678c324ad76d25b9575def889f0370ceb2e4","project_uri":"https://rubygems.org/gems/static_embeddings","gem_uri":"https://rubygems.org/gems/static_embeddings-0.1.5.gem","homepage_uri":"https://github.com/roman-haidarov/static_embeddings","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/roman-haidarov/static_embeddings","bug_tracker_uri":null,"changelog_uri":"https://github.com/roman-haidarov/static_embeddings/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"bundler","requirements":"~> 2.0"},{"name":"minitest","requirements":"~> 5.0"},{"name":"rake","requirements":"~> 13.0"},{"name":"rake-compiler","requirements":"~> 1.2"}],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/roman-haidarov/static_embeddings"}