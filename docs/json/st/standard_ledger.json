{"gems":{"name":"standard_ledger","downloads":4400,"version":"0.5.1","version_created_at":"2026-09-23T17:45:31.370Z","version_downloads":45,"platform":"ruby","ruby_abi":null,"authors":"Jaryl Sim","info":"StandardLedger captures the recurring 'append-only entry → N projection updates' pattern as a declarative DSL on host ActiveRecord models. Supports five projection modes — :inline, :async, :sql, :matview, :trigger — plus a deterministic rebuild path from the entry log, ad-hoc materialized view refresh, and a doctor rake task that verifies host-owned trigger presence. Enforces idempotency-by-unique-index and immutability at the entry level.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/rarebit-one/standard_ledger","changelog_uri":"https://github.com/rarebit-one/standard_ledger/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/rarebit-one/standard_ledger/issues","source_code_uri":"https://github.com/rarebit-one/standard_ledger"},"yanked":false,"sha":"53643163c317720f49fa37c229aa0e3be8327e02b9f52f0aff09b6dfbf855f25","spec_sha":"850aa37c57a2682266b45b65547873ae622bdf5c3e5db0cd6bba5098340ec5bf","project_uri":"https://rubygems.org/gems/standard_ledger","gem_uri":"https://rubygems.org/gems/standard_ledger-0.5.1.gem","homepage_uri":"https://github.com/rarebit-one/standard_ledger","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/rarebit-one/standard_ledger","bug_tracker_uri":"https://github.com/rarebit-one/standard_ledger/issues","changelog_uri":"https://github.com/rarebit-one/standard_ledger/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"brakeman","requirements":">= 0"},{"name":"bundler-audit","requirements":">= 0"},{"name":"simplecov","requirements":">= 0"}],"runtime":[{"name":"activejob","requirements":">= 8.0"},{"name":"activerecord","requirements":">= 8.0"},{"name":"activesupport","requirements":">= 8.0"},{"name":"concurrent-ruby","requirements":"~>