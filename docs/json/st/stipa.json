{"gems":{"name":"stipa","downloads":2369,"version":"0.2.6","version_created_at":"2026-07-30T15:27:35.693Z","version_downloads":11,"platform":"ruby","authors":"Jānis Harbs","info":"Stīpa is a lightweight, zero-dependency HTTP/1.1 framework built entirely on Ruby stdlib.\n\nFeatures:\n- Pure stdlib (socket, thread, erb, json, securerandom)\n- HTTP/1.1 with keep-alive, SO_REUSEPORT, and TCP_NODELAY\n- Thread pool with bounded queue and graceful shutdown\n- Pre-compiled middleware stack with zero per-request overhead\n- ERB templates with layouts, partials, and Vue 3 island helpers\n- CLI generator for MVC and API-only applications\n- Structured logging in logfmt format\n- Named route parameters via regex captures\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/janisharbs/stipa","changelog_uri":"https://github.com/janisharbs/stipa/releases","bug_tracker_uri":"https://github.com/janisharbs/stipa/issues","source_code_uri":"https://github.com/janisharbs/stipa","documentation_uri":"https://github.com/janisharbs/stipa","rubygems_mfa_required":"true"},"yanked":false,"sha":"b42e458d6c53a8827fceca8c7c012e36f7c4e06e2a7b2d0ca37521e62e1dc62b","spec_sha":"882d36e4e9dad6d765ddc63593a95c2b05c50d4849ad3a433a67ce68b19a8775","project_uri":"https://rubygems.org/gems/stipa","gem_uri":"https://rubygems.org/gems/stipa-0.2.6.gem","homepage_uri":"https://github.com/janisharbs/stipa","wiki_uri":null,"documentation_uri":"https://github.com/janisharbs/stipa","mailing_list_uri":null,"source_code_uri":"https://github.com/janisharbs/stipa","bug_tracker_uri":"https://github.com/janisharbs/stipa/issues","changelog_uri":"https://github.com/janisharbs/stipa/releases","funding_uri":null,"dependencies":{"development":[{"name":"minitest","requirements":"~> 5.20"},{"name":"rake","requirements":"~> 13.0"},{"name":"rubocop","requirements":"~> 1.50"},{"name":"yard","requirements":"~> 0.9"}],"runtime":[]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/janisharbs/stipa"}