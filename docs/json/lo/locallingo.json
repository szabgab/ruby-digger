{"gems":{"name":"locallingo","downloads":4523,"version":"0.4.2","version_created_at":"2026-08-18T12:19:07.848Z","version_downloads":110,"platform":"ruby","authors":"Mikael Henriksson","info":"Locallingo extends i18n-tasks with AI translation (via RubyLLM — OpenAI, Anthropic, and more), source-hash drift detection so only missing/changed keys are re-translated, and a static + AI translation-quality linter. Everything app-specific — target locales, provider/model, prompt context and glossary, per-language style guides, which validators and quality rules run, and post-translate hooks — is config-driven via `.locallingo.yml`, with a default block plus optional per-package overrides. Ships the `lingo` CLI.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/zoolutions/locallingo/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/zoolutions/locallingo/issues","source_code_uri":"https://github.com/zoolutions/locallingo","rubygems_mfa_required":"true"},"yanked":false,"sha":"7250ef44182e0c25fd3ba790a54710ad220340708e92e2ad20802cc6f1d0c764","spec_sha":"d1e8f3d8dbf4a6a98e584b17a9dc6473c810c46f5e12ddf7bf0854e317871a26","project_uri":"https://rubygems.org/gems/locallingo","gem_uri":"https://rubygems.org/gems/locallingo-0.4.2.gem","homepage_uri":"https://github.com/zoolutions/locallingo","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/zoolutions/locallingo","bug_tracker_uri":"https://github.com/zoolutions/locallingo/issues","changelog_uri":"https://github.com/zoolutions/locallingo/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"rubocop","requirements":">= 1.75, < 2"}],"runtime":[{"name":"ruby_llm","requirements":">= 1.0, < 2"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/zoolutions/locallingo"}