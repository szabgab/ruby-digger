{"gems":{"name":"locallingo","downloads":6991,"version":"0.6.0","version_created_at":"2026-10-15T20:31:44.806Z","version_downloads":67,"platform":"ruby","ruby_abi":null,"authors":"Mikael Henriksson","info":"Locallingo extends i18n-tasks with AI translation (via RubyLLM — OpenAI, Anthropic, and more), source-hash drift detection so only missing/changed keys are re-translated, and a static + AI translation-quality linter. Everything app-specific — target locales, provider/model, prompt context and glossary, per-language style guides, which validators and quality rules run, and post-translate hooks — is config-driven via `.locallingo.yml`, with a default block plus optional per-package overrides. Ships the `lingo` CLI.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/zoolutions/locallingo/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/zoolutions/locallingo/issues","source_code_uri":"https://github.com/zoolutions/locallingo","rubygems_mfa_required":"true"},"yanked":false,"sha":"73d73d8954af83162ad87ba3e2b3b58a1d77ba79681c47fe8aabccaa09033f89","spec_sha":"9c1e15daf0291bda4215cf7a8b47a66e3a1e955b12aa0533b598c1897825f38f","project_uri":"https://rubygems.org/gems/locallingo","gem_uri":"https://rubygems.org/gems/locallingo-0.6.0.gem","homepage_uri":"https://github.com/zoolutions/locallingo","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/zoolutions/locallingo","bug_tracker_uri":"https://github.com/zoolutions/locallingo/issues","changelog_uri":"https://github.com/zoolutions/locallingo/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"rubocop","requirements":">= 1.75, < 2"}],"runtime":[{"name":"ruby_llm","requirements":">= 2.1, < 3"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/zoolutions/locallingo"}