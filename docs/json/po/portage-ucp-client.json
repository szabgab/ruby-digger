{"gems":{"name":"portage-ucp-client","downloads":2193,"version":"0.2.0","version_created_at":"2026-08-21T03:59:51.917Z","version_downloads":32,"platform":"ruby","authors":"Tom Whitbread","info":"Every other portage-ucp gem lets a Ruby program expose a commerce backend to agents (server side). This gem is the other direction: connect to somebody else's /.well-known/ucp manifest, or drive your own Adapter directly, and place an order as the client. Three transports behind one interface (loopback over an in-process Adapter, stdio, Streamable HTTP) — callers never know which they got. Depends only on portage-ucp + the mcp gem's client half; no adapter gem is a dependency.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/tomtom87/Portage/blob/main/portage-ucp-client/CHANGELOG.md","source_code_uri":"https://github.com/tomtom87/Portage/tree/main/portage-ucp-client","rubygems_mfa_required":"true"},"yanked":false,"sha":"4535ac22ac336dd0688507797659ca98bc95748e0d8a6f1dbddbe339889115ae","spec_sha":"4a59e4b0541c7d74be5ae5096c65b57049cadb2e182ba8455cfd60ab7c8a8c02","project_uri":"https://rubygems.org/gems/portage-ucp-client","gem_uri":"https://rubygems.org/gems/portage-ucp-client-0.2.0.gem","homepage_uri":"https://github.com/tomtom87/Portage/tree/main/portage-ucp-client","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/tomtom87/Portage/tree/main/portage-ucp-client","bug_tracker_uri":null,"changelog_uri":"https://github.com/tomtom87/Portage/blob/main/portage-ucp-client/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"rspec","requirements":"~> 3.13"},{"name":"rubocop","requirements":"~> 1.88"},{"name":"webmock","requirements":"~> 3.24"},{"name":"yard","requirements":"~> 0.9"}],"runtime":[{"name":"mcp","requirements":"~> 0.24"},{"name":"portage-ucp","requirements":"~> 0.2"}]}},"vcs_name":"GitHub","ci":null,"vcs_error":"ERROR","vcs_uri":"https://github.com/tomtom87/Portage/tree/main/port