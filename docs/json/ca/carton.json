{"gems":{"name":"carton","downloads":642,"version":"0.4.0","version_created_at":"2026-10-22T05:07:37.574Z","version_downloads":0,"platform":"ruby","ruby_abi":null,"authors":"David Cristofaro","info":"Split your app into Cartons with explicit imports and exports. Each has its own dependencies and runs in a separate Ruby::Box, so Ruby enforces the boundaries at runtime. Only what a Carton exports is reachable, monkey patches stay where they are made, and two Cartons can use different versions of the same gem. No manifest needed. Requires Ruby 4.0.7+.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/dtcristo/carton","changelog_uri":"https://github.com/dtcristo/carton/blob/main/CHANGELOG.md","allowed_push_host":"https://rubygems.org","rubygems_mfa_required":"true"},"yanked":false,"sha":"11bc886d9ee04164e04ea826ab59808ce2493c714fdd6f8cfb70c07778b62511","spec_sha":"1e7a533490f07cad8a68885f4da1ea4f4ff0fdf30baa3fd99851b1222f639cfc","project_uri":"https://rubygems.org/gems/carton","gem_uri":"https://rubygems.org/gems/carton-0.4.0.gem","homepage_uri":"https://github.com/dtcristo/carton","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":"https://github.com/dtcristo/carton/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/dtcristo/carton"}