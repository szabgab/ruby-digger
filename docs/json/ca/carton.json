{"gems":{"name":"carton","downloads":459,"version":"0.3.0","version_created_at":"2026-10-18T07:53:35.689Z","version_downloads":69,"platform":"ruby","ruby_abi":null,"authors":"David Cristofaro","info":"The package system Ruby has been missing. Split code into Cartons that import and export like modules. Each Carton runs in its own Ruby::Box, so only what it exports is reachable, monkey patches stay where they are made, and two Cartons can use different versions of the same gem. No manifest needed. Requires Ruby 4.0.7+.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/dtcristo/carton","changelog_uri":"https://github.com/dtcristo/carton/blob/main/CHANGELOG.md","allowed_push_host":"https://rubygems.org","rubygems_mfa_required":"true"},"yanked":false,"sha":"27addbeaf4e3b5294dc764d8827f9d2c868a6acfbb5250e91ce1fe160a1e92fd","spec_sha":"4742a96101ec1e10cc0c1fd27847469f4954bc66505a9e3cbe9cca1d72b85a27","project_uri":"https://rubygems.org/gems/carton","gem_uri":"https://rubygems.org/gems/carton-0.3.0.gem","homepage_uri":"https://github.com/dtcristo/carton","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":"https://github.com/dtcristo/carton/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/dtcristo/carton"}