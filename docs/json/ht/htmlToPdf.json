{"gems":{"name":"htmlToPdf","downloads":23079,"version":"4.0.0","version_created_at":"2026-11-24T15:50:05.757Z","version_downloads":34,"platform":"ruby","ruby_abi":null,"authors":"Ram Laxman Yadav","info":"HtmlToPdf lets any Rails controller action be downloaded as a PDF. Request the action with a PDF format and the gem renders the view exactly as the browser would, then converts it to PDF via a pooled headless Chrome instance (through the ferrum gem) — synchronously, in-request, or in the background via HtmlToPdf.generate_later (ActiveJob, so it runs under Sidekiq/Solid Queue/any adapter), with job status tracking and S3/ActiveStorage storage. Supports Rails 7.x and 8.x.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/ramlaxmanyadav/htmlToPdf/blob/master/CHANGELOG.md","bug_tracker_uri":"https://github.com/ramlaxmanyadav/htmlToPdf/issues","source_code_uri":"https://github.com/ramlaxmanyadav/htmlToPdf","documentation_uri":"https://ramlaxmanyadav.github.io/htmlToPdf/","rubygems_mfa_required":"true"},"yanked":false,"sha":"33c6af261b0aceac83205fec8ff9613e1f923b1315cecc73233e4530fd07590c","spec_sha":"63589a3b92fd03958a0760542fb7baa3c8ebc15ef58b9dc100874e874e18bf9a","project_uri":"https://rubygems.org/gems/htmlToPdf","gem_uri":"https://rubygems.org/gems/htmlToPdf-4.0.0.gem","homepage_uri":"https://github.com/ramlaxmanyadav/htmlToPdf","wiki_uri":null,"documentation_uri":"https://ramlaxmanyadav.github.io/htmlToPdf/","mailing_list_uri":null,"source_code_uri":"https://github.com/ramlaxmanyadav/htmlToPdf","bug_tracker_uri":"https://github.com/ramlaxmanyadav/htmlToPdf/issues","changelog_uri":"https://github.com/ramlaxmanyadav/htmlToPdf/blob/master/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"aws-sdk-s3","requirements":"~> 1.0"},{"name":"bundler","requirements":">= 2.4, < 5"},{"name":"bundler-audit","requirements":"~> 0.9"},{"name":"combustion","requirements":"~> 1.5"},{"name":"rails","requirements":">= 7.0, < 9"},{"name":"rake","r