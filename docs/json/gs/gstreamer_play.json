{"gems":{"name":"gstreamer_play","downloads":179,"version":"1.1.0","version_created_at":"2026-11-03T03:21:55.296Z","version_downloads":88,"platform":"ruby","ruby_abi":null,"authors":"Nathan Kidd","info":"GstPlay for Ruby, defined from its GObject Introspection typelib at require time rather than wrapped by hand. A URI in, playback out: GstPlay builds and drives the pipeline itself, runs its own main context, and reports state, position, errors and discovered media as signals and bus messages -- so it needs no event loop of yours to run, in a GTK application or out of one. Pure Ruby: there is no extension to compile, and the binding does not drift as GstPlay gains API.","licenses":["Apache-2.0"],"metadata":{"source_code_uri":"https://github.com/n-at-han-k/gstreamer-play-rb","documentation_uri":"https://n-at-han-k.github.io/gstreamer-play-rb/"},"yanked":false,"sha":"d13a63699c6931a61f36fd44b735b956f4e3b3f4b2f82230b1dad9e847064527","spec_sha":"5e9d01c368ab063a20e75cb63143ebc620b845712485eba6f04b2be6d713a30c","project_uri":"https://rubygems.org/gems/gstreamer_play","gem_uri":"https://rubygems.org/gems/gstreamer_play-1.1.0.gem","homepage_uri":"https://github.com/n-at-han-k/gstreamer-play-rb","wiki_uri":null,"documentation_uri":"https://n-at-han-k.github.io/gstreamer-play-rb/","mailing_list_uri":null,"source_code_uri":"https://github.com/n-at-han-k/gstreamer-play-rb","bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[{"name":"lefthook","requirements":"~> 2.2"}],"runtime":[{"name":"gem_kit","requirements":"~> 0.2"},{"name":"gobject-introspection","requirements":"~> 4.3"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/n-at-han-k/gstreamer-play-rb"}