{"gems":{"name":"uml-viewer","downloads":293,"version":"0.1.1","version_created_at":"2026-10-23T11:07:13.459Z","version_downloads":183,"platform":"ruby","ruby_abi":null,"authors":"Robert Hopman","info":"uml-viewer scans a Ruby or Rails project with Prism and shows it as a UML diagram in the browser. Red arrows show dependencies that break the Dependency Rule between Rails layers. Box colors show CRAP from a SimpleCov run. A right-click sends a command to a Claude Code session, which explains the code, changes the policy or writes a proposal. Nothing is written into the viewed project. Based on the ideas of unclebob/uml-viewer by Robert C. Martin (Uncle Bob), a Clojure tool. No code is copied.","licenses":["MIT","EPL-2.0"],"metadata":{"changelog_uri":"https://github.com/roberthopman/uml-viewer/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/roberthopman/uml-viewer","allowed_push_host":"https://rubygems.org","rubygems_mfa_required":"true"},"yanked":false,"sha":"bc3bd175473a0aaa96835c6c1ce1b63c62c6bae9b8fcf6cf2e84087e38871e9f","spec_sha":"432a1fe8ad5e06c26051a906c16df2aba9951f8ac04822f752a450386e60e2dc","project_uri":"https://rubygems.org/gems/uml-viewer","gem_uri":"https://rubygems.org/gems/uml-viewer-0.1.1.gem","homepage_uri":"https://github.com/roberthopman/uml-viewer","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/roberthopman/uml-viewer","bug_tracker_uri":null,"changelog_uri":"https://github.com/roberthopman/uml-viewer/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"prism","requirements":">= 1.9"},{"name":"webrick","requirements":"~> 1.9"}]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/roberthopman/uml-viewer"}