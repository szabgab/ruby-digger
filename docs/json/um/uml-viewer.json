{"gems":{"name":"uml-viewer","downloads":482,"version":"0.1.2","version_created_at":"2026-10-23T12:10:40.864Z","version_downloads":112,"platform":"ruby","ruby_abi":null,"authors":"Robert Hopman","info":"uml-viewer scans a Ruby or Rails project with Prism and shows it as a UML diagram in the browser. Red arrows show dependencies that break the Dependency Rule between Rails layers. Box colors show CRAP from a SimpleCov run. A right-click sends a command to a Claude Code session, which explains the code, changes the policy or writes a proposal. Nothing is written into the viewed project. Based on the ideas of unclebob/uml-viewer by Robert C. Martin (Uncle Bob), a Clojure tool. No code is copied.","licenses":["MIT","EPL-2.0"],"metadata":{"changelog_uri":"https://github.com/roberthopman/uml-viewer/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/roberthopman/uml-viewer","allowed_push_host":"https://rubygems.org","rubygems_mfa_required":"true"},"yanked":false,"sha":"36db9d528990b6adf1c606fb06f22b9d9dd58c46c99cf731cb8a7d9a28ea9878","spec_sha":"67a8e0697c87160624ea28761c76dc92b6ebb20c25f71f4970d7981b0d7e6ad7","project_uri":"https://rubygems.org/gems/uml-viewer","gem_uri":"https://rubygems.org/gems/uml-viewer-0.1.2.gem","homepage_uri":"https://github.com/roberthopman/uml-viewer","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/roberthopman/uml-viewer","bug_tracker_uri":null,"changelog_uri":"https://github.com/roberthopman/uml-viewer/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"prism","requirements":">= 1.9"},{"name":"webrick","requirements":"~> 1.9"}]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/roberthopman/uml-viewer"}