{"gems":{"name":"schema_reaper","downloads":4528,"version":"1.0.9","version_created_at":"2026-09-09T06:19:17.948Z","version_downloads":102,"platform":"ruby","ruby_abi":null,"authors":"aksshatt, mitkush","info":"schema_reaper finds schema dead-weight in Rails/ActiveRecord + PostgreSQL apps: dead columns and tables, unused, duplicate and missing foreign-key indexes, and always-NULL or single-value columns. It cross-references the live schema and pg_stats against a static scan of your code, with an optional production runtime signal for higher confidence. Each finding is scored, carries a reclaimable-bytes estimate, and ships with a staged, reversible migration. Reporters for terminal, JSON, Markdown and SARIF; a CI baseline gate; a trend log; a Rails railtie. PostgreSQL only for now; Ruby >= 2.7. See the README for full usage.","licenses":["MIT"],"metadata":{"wiki_uri":"https://github.com/aksshatt/schema_reaper/wiki","funding_uri":"https://github.com/sponsors/aksshatt","homepage_uri":"https://github.com/aksshatt/schema_reaper","changelog_uri":"https://github.com/aksshatt/schema_reaper/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/aksshatt/schema_reaper/issues","source_code_uri":"https://github.com/aksshatt/schema_reaper","allowed_push_host":"https://rubygems.org","documentation_uri":"https://github.com/aksshatt/schema_reaper#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"fd0dd2111ab4c06287fab69424faab79ee95311d85d06d8e23becea23bad22ff","spec_sha":"3d3ebdd90f5546ee734c5f00d809626d6db700b407d79e5e0710330093e9f2c0","project_uri":"https://rubygems.org/gems/schema_reaper","gem_uri":"https://rubygems.org/gems/schema_reaper-1.0.9.gem","homepage_uri":"https://github.com/aksshatt/schema_reaper","wiki_uri":"https://github.com/aksshatt/schema_reaper/wiki","documentation_uri":"https://github.com/aksshatt/schema_reaper#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/aksshatt/schema_reaper","bug_tracker_uri":"https://github.com/a