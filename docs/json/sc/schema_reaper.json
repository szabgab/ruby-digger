{"gems":{"name":"schema_reaper","downloads":5022,"version":"1.0.11","version_created_at":"2026-09-15T07:02:25.751Z","version_downloads":0,"platform":"ruby","ruby_abi":null,"authors":"aksshatt, mitkush","info":"schema_reaper finds schema dead-weight in Rails/ActiveRecord + PostgreSQL apps: dead columns and tables, unused, duplicate and missing foreign-key indexes, and always-NULL or single-value columns. It cross-references the live schema and pg_stats against a static scan of your code, with an optional production runtime signal for higher confidence. Each finding is scored, carries a reclaimable-bytes estimate, and ships with a staged, reversible migration. Reporters for terminal, JSON, Markdown and SARIF; a CI baseline gate; a trend log; a Rails railtie. PostgreSQL only for now; Ruby >= 2.7. See the README for full usage.","licenses":["MIT"],"metadata":{"wiki_uri":"https://github.com/aksshatt/schema_reaper/wiki","funding_uri":"https://github.com/sponsors/aksshatt","homepage_uri":"https://github.com/aksshatt/schema_reaper","changelog_uri":"https://github.com/aksshatt/schema_reaper/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/aksshatt/schema_reaper/issues","source_code_uri":"https://github.com/aksshatt/schema_reaper","allowed_push_host":"https://rubygems.org","documentation_uri":"https://github.com/aksshatt/schema_reaper#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"f02087df95996fbcac058d1b76d7f2ec8f5345ff56810cf3e8b325ec7e2843c3","spec_sha":"aa0c6765c57c8276fb69782310dda10fef68450a2c39751be3e36eb3a7d9db9f","project_uri":"https://rubygems.org/gems/schema_reaper","gem_uri":"https://rubygems.org/gems/schema_reaper-1.0.11.gem","homepage_uri":"https://github.com/aksshatt/schema_reaper","wiki_uri":"https://github.com/aksshatt/schema_reaper/wiki","documentation_uri":"https://github.com/aksshatt/schema_reaper#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/aksshatt/schema_reaper","bug_tracker_uri":"https://github.com/a