{"gems":{"name":"schema_reaper","downloads":941,"version":"1.0.7","version_created_at":"2026-09-04T11:24:21.272Z","version_downloads":95,"platform":"ruby","ruby_abi":null,"authors":"aksshatt, mitkush","info":"schema_reaper finds schema dead-weight in Rails/ActiveRecord + PostgreSQL apps: dead columns and tables, unused, duplicate and missing foreign-key indexes, and always-NULL or single-value columns. It cross-references the live schema and pg_stats against a static scan of your code, with an optional production runtime signal for higher confidence. Each finding is scored, carries a reclaimable-bytes estimate, and ships with a staged, reversible migration. Reporters for terminal, JSON, Markdown and SARIF; a CI baseline gate; a trend log; a Rails railtie. PostgreSQL only for now; Ruby >= 2.7. See the README for full usage.","licenses":["MIT"],"metadata":{"wiki_uri":"https://github.com/aksshatt/schema_reaper/wiki","funding_uri":"https://github.com/sponsors/aksshatt","homepage_uri":"https://github.com/aksshatt/schema_reaper","changelog_uri":"https://github.com/aksshatt/schema_reaper/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/aksshatt/schema_reaper/issues","source_code_uri":"https://github.com/aksshatt/schema_reaper","allowed_push_host":"https://rubygems.org","documentation_uri":"https://github.com/aksshatt/schema_reaper#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"50123473e22f7d6eaa0a3651a7747544c02294bb905ff7120f2d121c199b482c","spec_sha":"2f0b1da0a89be674de0eaa86bf6d1442cb7353a126165f9e9da8c6afbf3ab3f1","project_uri":"https://rubygems.org/gems/schema_reaper","gem_uri":"https://rubygems.org/gems/schema_reaper-1.0.7.gem","homepage_uri":"https://github.com/aksshatt/schema_reaper","wiki_uri":"https://github.com/aksshatt/schema_reaper/wiki","documentation_uri":"https://github.com/aksshatt/schema_reaper#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/aksshatt/schema_reaper","bug_tracker_uri":"https://github.com/aksshatt/schema_reaper/issues","changelog_uri":"https://github.com/aksshatt/schema_reaper/blob/main/CHANGELOG.md","funding_uri":"https://github.com/sponsors/aksshatt","dependencies":{"development":[{"name":"activerecord","requirements":">= 6.1, < 9.0"},{"name":"pg","requirements":"~> 1.5"}],"runtime":[{"name":"prism","requirements":">= 0.19, < 2.0"},{"name":"thor","requirements":"~> 1.3"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/aksshatt/schema_reaper"}