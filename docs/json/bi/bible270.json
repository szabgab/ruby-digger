{"gems":{"name":"bible270","downloads":474,"version":"0.6.3","version_created_at":"2026-07-25T03:06:35.155Z","version_downloads":284,"platform":"ruby","authors":"Andrew vonderLuft","info":"Drop-in Rails engine that adds a social daily Bible reading plan over 270 days: the Old Testament once, the New Testament twice, and a whole-chapter Psalms/Proverbs companion. Daily portions are balanced by verse count so each day takes about the same time to read, and chapters are never split except Psalm 119. Readers check off each day's readings, leave reflections, and see one another's progress. Designed to mount cleanly into a host Rails app such as ComfortableMediaSurfer.","licenses":["MIT"],"metadata":{"homepage_uri":"https://gknt.org","changelog_uri":"https://github.com/avonderluft/bible270/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/avonderluft/bible270/issues","source_code_uri":"https://github.com/avonderluft/bible270","rubygems_mfa_required":"true"},"yanked":false,"sha":"79a9dc7e536c7912ff4591100cd30c91ae8f2a4776eb4c3039209f0c95269d84","spec_sha":"ab06b97b5bed573ae054e12af8baa8ddfd4a9f2d68928de6cce058cdef3cc389","project_uri":"https://rubygems.org/gems/bible270","gem_uri":"https://rubygems.org/gems/bible270-0.6.3.gem","homepage_uri":"https://gknt.org","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/avonderluft/bible270","bug_tracker_uri":"https://github.com/avonderluft/bible270/issues","changelog_uri":"https://github.com/avonderluft/bible270/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"minitest","requirements":"~> 5.0"}],"runtime":[{"name":"omniauth","requirements":">= 2.0"},{"name":"omniauth-rails_csrf_protection","requirements":">= 1.0"},{"name":"rails","requirements":">= 7.0"}]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/avonderluft/bible270"}