{"gems":{"name":"bindata","downloads":143790171,"version":"3.0.1","version_created_at":"2026-09-27T05:26:59.365Z","version_downloads":180,"platform":"ruby","ruby_abi":null,"authors":"Dion Mendel","info":"BinData is a declarative way to read and write binary file formats.\n\nThis means the programmer specifies *what* the format of the binary\ndata is, and BinData works out *how* to read and write data in this\nformat.  It is an easier ( and more readable ) alternative to\nruby's #pack and #unpack methods.\n","licenses":["BSD-2-Clause"],"metadata":{"changelog_uri":"https://github.com/dmendel/bindata/blob/master/ChangeLog.rdoc"},"yanked":false,"sha":"e97a826a12f6e7c5847e983e5826f277d61035317d352ec339b079537f2fa466","spec_sha":"2be91caee12d338477f19d694de12332c2f61b7bae2d163b0b6b478c444e6bfb","project_uri":"https://rubygems.org/gems/bindata","gem_uri":"https://rubygems.org/gems/bindata-3.0.1.gem","homepage_uri":"https://github.com/dmendel/bindata","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":"https://github.com/dmendel/bindata/blob/master/ChangeLog.rdoc","funding_uri":null,"dependencies":{"development":[{"name":"minitest","requirements":"~> 5.0"},{"name":"rake","requirements":">= 0"},{"name":"simplecov","requirements":">= 0"}],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/dmendel/bindata"}