{"gems":{"name":"ozdenui","downloads":495,"version":"0.1.4","version_created_at":"2026-11-17T14:47:02.611Z","version_downloads":38,"platform":"ruby","ruby_abi":null,"authors":"Bugra Ozden","info":"OzdenUI for Ruby opens a window of its own whose objects are the objects of basic.js and the 80+ components of the OzdenUI kit (buttons, fields, lists, tables, charts, dialogs, editors), written in Ruby with blocks. On macOS the window is the web view of the system, made with the fiddle library of Ruby; on Windows and Linux it is an app window of Edge or Chrome. No other gem and no compiler are needed; it also works with the Ruby that comes with macOS.","licenses":["Apache-2.0"],"metadata":{"homepage_uri":"https://bug7a.github.io/ozdenui-ruby/","changelog_uri":"https://github.com/bug7a/ozdenui-ruby/releases","bug_tracker_uri":"https://github.com/bug7a/ozdenui-ruby/issues","source_code_uri":"https://github.com/bug7a/ozdenui-ruby"},"yanked":false,"sha":"4423c80c6774e64a07255ca88905571b601d980eafdb70c63182aca36517481a","spec_sha":"db118f34cb7b6e9ac764f7eaab72f51f26f2b6ebce0b0e7e5002008fad0c2512","project_uri":"https://rubygems.org/gems/ozdenui","gem_uri":"https://rubygems.org/gems/ozdenui-0.1.4.gem","homepage_uri":"https://bug7a.github.io/ozdenui-ruby/","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/bug7a/ozdenui-ruby","bug_tracker_uri":"https://github.com/bug7a/ozdenui-ruby/issues","changelog_uri":"https://github.com/bug7a/ozdenui-ruby/releases","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/bug7a/ozdenui-ruby"}