{"gems":{"name":"shakha","downloads":2262,"version":"0.9.0","version_created_at":"2026-10-03T08:49:22.198Z","version_downloads":42,"platform":"ruby","ruby_abi":null,"authors":"Asrat","info":"Shakha is a headless OAuth broker engine for Rails APIs and monoliths.\nYour frontend does a single redirect; Shakha runs the OAuth dance\n(PKCE, state) against Google or GitHub, stores a revocable\ndatabase-backed session, and redirects back with a session token usable\nvia encrypted cookie or Authorization: Bearer. No JWTs issued, no Redis,\nno frontend SDK. Pre-1.0: APIs and security posture still evolving.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/Asrat77/shakha","changelog_uri":"https://github.com/Asrat77/shakha/blob/master/CHANGELOG.md","bug_tracker_uri":"https://github.com/Asrat77/shakha/issues","source_code_uri":"https://github.com/Asrat77/shakha","rubygems_mfa_required":"true"},"yanked":false,"sha":"3d71f69d337ac4d715de1119e64ae8bf50c20e54ebc2ed2fe76b3da2a6101270","spec_sha":"b9ae1b7e9aa9ebd5360c945969a1c2f13087aa628e3ee9492f48c5911f5c67ce","project_uri":"https://rubygems.org/gems/shakha","gem_uri":"https://rubygems.org/gems/shakha-0.9.0.gem","homepage_uri":"https://github.com/Asrat77/shakha","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/Asrat77/shakha","bug_tracker_uri":"https://github.com/Asrat77/shakha/issues","changelog_uri":"https://github.com/Asrat77/shakha/blob/master/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activesupport","requirements":">= 7.1, < 10"},{"name":"jwt","requirements":">= 2.10.3, < 3"},{"name":"railties","requirements":">= 7.1, < 10"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Asrat77/shakha"}