{"gems":{"name":"shakha","downloads":1720,"version":"0.8.0","version_created_at":"2026-07-27T08:09:22.035Z","version_downloads":169,"platform":"ruby","authors":"Asrat","info":"Shakha is a headless OAuth broker engine for Rails APIs and monoliths.\nYour frontend does a single redirect; Shakha runs the OAuth dance\n(PKCE, state) against Google or GitHub, stores a revocable\ndatabase-backed session, and redirects back with a session token usable\nvia encrypted cookie or Authorization: Bearer. No JWTs issued, no Redis,\nno frontend SDK. Pre-1.0: APIs and security posture still evolving.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/Asrat77/shakha","changelog_uri":"https://github.com/Asrat77/shakha/blob/master/CHANGELOG.md","bug_tracker_uri":"https://github.com/Asrat77/shakha/issues","source_code_uri":"https://github.com/Asrat77/shakha","rubygems_mfa_required":"true"},"yanked":false,"sha":"2876fd6a091fff5865105e508971ae7fa1e3916b0efd3e66b0532b181d2dd2d6","spec_sha":"72aca6909e45a3ff311906ed10b1fa3597a4936044682208c9129b030b1d2c79","project_uri":"https://rubygems.org/gems/shakha","gem_uri":"https://rubygems.org/gems/shakha-0.8.0.gem","homepage_uri":"https://github.com/Asrat77/shakha","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/Asrat77/shakha","bug_tracker_uri":"https://github.com/Asrat77/shakha/issues","changelog_uri":"https://github.com/Asrat77/shakha/blob/master/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activesupport","requirements":">= 7.1, < 10"},{"name":"jwt","requirements":">= 2.10.3, < 3"},{"name":"railties","requirements":">= 7.1, < 10"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Asrat77/shakha"}