{"gems":{"name":"zpl_render","downloads":145,"version":"0.2.0","version_created_at":"2026-07-31T13:16:18.545Z","version_downloads":40,"platform":"ruby","authors":"Waqas Ali","info":"A pure-Ruby ZPL II renderer. Parses ^XA..^XZ label formats and rasterizes them at true printer resolution (dots), producing PNG images and print-size PDF documents. Code 128 (^BC, incl. Zebra subset invocation codes and GS1 modes), QR (^BQ), Code 39 (^B3) and Interleaved 2 of 5 (^B2) are generated module-exact so scanners read them reliably. Also supports text fields, field blocks, graphic boxes/circles/diagonals, ^GF images (ASCII hex, Zebra RLE, B64/Z64) and ~DG/^XG stored graphics.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/wqsaali/zpl_render","changelog_uri":"https://github.com/wqsaali/zpl_render/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/wqsaali/zpl_render/issues","source_code_uri":"https://github.com/wqsaali/zpl_render","rubygems_mfa_required":"true"},"yanked":false,"sha":"c5f633fc1e1f387f776cfc33ab0bdbb0b4ad2f28ea5279387b7e7176c3b37e1f","spec_sha":"c34411ef414fd05ff72339ab9021f5a6c816983139f172811ef581ec87ad7d0b","project_uri":"https://rubygems.org/gems/zpl_render","gem_uri":"https://rubygems.org/gems/zpl_render-0.2.0.gem","homepage_uri":"https://github.com/wqsaali/zpl_render","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/wqsaali/zpl_render","bug_tracker_uri":"https://github.com/wqsaali/zpl_render/issues","changelog_uri":"https://github.com/wqsaali/zpl_render/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"chunky_png","requirements":"~> 1.4"},{"name":"prawn","requirements":">= 2.4, < 3"},{"name":"rqrcode_core","requirements":"~> 2.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/wqsaali/zpl_render"}