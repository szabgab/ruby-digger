{"gems":{"name":"whoosh","downloads":4746,"version":"2.0.2","version_created_at":"2026-11-26T10:19:48.683Z","version_downloads":52,"platform":"ruby","ruby_abi":null,"authors":"Johannes Dwi Cahyo Kristanto","info":"Whoosh is a small JSON API framework built straight on the Rack spec.\nEndpoints are deny-by-default: every one must declare who may call it,\nwhat input it accepts and what output it returns, or the app refuses to\nboot. It ships one error envelope, request IDs, body and page-size limits,\nrate limiting, idempotency keys, cursor pagination, CORS and security\nheaders, and generates OpenAPI from the same schemas. Its only runtime\ndependency is bigdecimal.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/johannesdwicahyo/whoosh/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/johannesdwicahyo/whoosh","rubygems_mfa_required":"true"},"yanked":false,"sha":"9f574844bdbad2fa9ad3c4c3039d590d931fd3d24eb931987d54be208bbd6d0a","spec_sha":"ba80cb4542b6cf2e05861bdc2f3428c48732221a9d5296730cbbe95807ad3be6","project_uri":"https://rubygems.org/gems/whoosh","gem_uri":"https://rubygems.org/gems/whoosh-2.0.2.gem","homepage_uri":"https://github.com/johannesdwicahyo/whoosh","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/johannesdwicahyo/whoosh","bug_tracker_uri":null,"changelog_uri":"https://github.com/johannesdwicahyo/whoosh/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"bigdecimal","requirements":">= 0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/johannesdwicahyo/whoosh"}