{"gems":{"name":"nti_event_bus","downloads":1119,"version":"0.1.1","version_created_at":"2026-07-28T07:48:11.285Z","version_downloads":80,"platform":"ruby","authors":"Den Meralpis","info":"NtiEventBus is a lightweight publish/subscribe event bus. Declare `domain.action` subscriptions in a small DSL, publish events, and fan them out to handler classes asynchronously via ActiveJob. The subscription registry is built once and deep-frozen for lock-free reads, so publishing adds no locking and no unbounded state.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/nueca-tech/nti_event_bus","changelog_uri":"https://github.com/nueca-tech/nti_event_bus/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/nueca-tech/nti_event_bus","allowed_push_host":"https://rubygems.org","rubygems_mfa_required":"true"},"yanked":false,"sha":"12e79738cdb2d6e3b1f8d7e4fc5f87db6fa81b9bd646697bf4871522a201dddd","spec_sha":"6244ce825d30e5409c6e38f43a7ba9c28b5ec17a160a511e28f4dd0236b2613c","project_uri":"https://rubygems.org/gems/nti_event_bus","gem_uri":"https://rubygems.org/gems/nti_event_bus-0.1.1.gem","homepage_uri":"https://github.com/nueca-tech/nti_event_bus","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/nueca-tech/nti_event_bus","bug_tracker_uri":null,"changelog_uri":"https://github.com/nueca-tech/nti_event_bus/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activejob","requirements":">= 7.1"},{"name":"activesupport","requirements":">= 7.1"}]}},"vcs_name":"GitHub","ci":null,"vcs_error":"ERROR","vcs_uri":"https://github.com/nueca-tech/nti_event_bus"}