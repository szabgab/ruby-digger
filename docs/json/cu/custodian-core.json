{"gems":{"name":"custodian-core","downloads":464,"version":"0.1.1","version_created_at":"2026-08-19T06:21:20.831Z","version_downloads":141,"platform":"ruby","authors":"Lucas Nunes de Sousa","info":"Custodian::Core resolves a chain of custody over a tree of responsibilities: it identifies the next responsible party and demands the action a previous ward could not fulfill, climbing the tree until someone can act. It carries no business rules from any specific domain - concrete domains are implemented as satellite gems that register actions into this core via a registry.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/lucasnssoftwareengineer-alt/custodian-core/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/lucasnssoftwareengineer-alt/custodian-core","rubygems_mfa_required":"true"},"yanked":false,"sha":"d6d4375eda713ec60c1d1dd38bfd891f114d50bb4d02b0d8038212d9737d74ef","spec_sha":"c0b2e4fae79be82a7afb066acabf144baa20a9a474bb59d73be3f174d78f52d8","project_uri":"https://rubygems.org/gems/custodian-core","gem_uri":"https://rubygems.org/gems/custodian-core-0.1.1.gem","homepage_uri":"https://github.com/lucasnssoftwareengineer-alt/custodian-core","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/lucasnssoftwareengineer-alt/custodian-core","bug_tracker_uri":null,"changelog_uri":"https://github.com/lucasnssoftwareengineer-alt/custodian-core/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"actionpack","requirements":">= 7.0, < 9.0"},{"name":"activerecord","requirements":">= 7.0, < 9.0"},{"name":"activesupport","requirements":">= 7.0, < 9.0"},{"name":"ancestry","requirements":">= 4.0, < 6.0"},{"name":"railties","requirements":">= 7.0, < 9.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/lucasnssoftwareengineer-alt/custodian-core"}