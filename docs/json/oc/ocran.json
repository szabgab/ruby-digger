{"gems":{"name":"ocran","downloads":16918,"version":"1.5.1","version_created_at":"2026-10-16T09:09:46.341Z","version_downloads":94,"platform":"ruby","ruby_abi":null,"authors":"Andi Idogawa, shinokaro, Lars Christensen","info":"OCRAN (One-Click Ruby Application Next) packages Ruby applications for distribution on Windows, Linux, and macOS. It bundles your script, the Ruby interpreter, gems, and native libraries into a self-contained artifact that runs without Ruby installed on the target machine: a self-extracting executable (default), a directory (--output-dir), a zip archive (--output-zip), or a macOS .app bundle (--macosx-bundle). Fork of OCRA maintained for Ruby 3.3+; migrating code should replace OCRA_EXECUTABLE with OCRAN_EXECUTABLE.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/largo/ocran","changelog_uri":"https://github.com/largo/ocran/blob/master/CHANGELOG.txt","bug_tracker_uri":"https://github.com/largo/ocran/issues","source_code_uri":"https://github.com/largo/ocran","documentation_uri":"https://github.com/largo/ocran#readme"},"yanked":false,"sha":"5e9744775e4f3fd7914c0848357922b8564c6a48b1307c5bf94f8a80b9e895be","spec_sha":"4ae7edf0b2464b4ffe16aed4998cf838970aa77b890383467f42c401ffad0124","project_uri":"https://rubygems.org/gems/ocran","gem_uri":"https://rubygems.org/gems/ocran-1.5.1.gem","homepage_uri":"https://github.com/largo/ocran","wiki_uri":null,"documentation_uri":"https://github.com/largo/ocran#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/largo/ocran","bug_tracker_uri":"https://github.com/largo/ocran/issues","changelog_uri":"https://github.com/largo/ocran/blob/master/CHANGELOG.txt","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"fiddle","requirements":"~> 1.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/largo/ocran"}