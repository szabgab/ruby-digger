{"gems":{"name":"solid_objects","downloads":26151,"version":"1.0.5","version_created_at":"2026-10-19T00:07:07.489Z","version_downloads":19,"platform":"ruby","ruby_abi":null,"authors":"Lucas Carlson","info":"Fix race conditions on one record in Rails: ordered operations, expiring holds, and durable state in your existing SQL database. Solid Objects is a SQL-backed virtual actor library for Ruby on Rails. It brings the Cloudflare Durable Objects programming model to Rails: addressable objects with ordered mailboxes, fenced activation, per-object reminders, transactional effects, and reactive ERB. It runs on MySQL, PostgreSQL, and SQLite without Redis, and requires Ruby 3.3 or newer and Rails 7.1 or newer.","licenses":["MIT"],"metadata":{"homepage_uri":"https://solidobjects.dev/ruby","changelog_uri":"https://github.com/cardmagic/solid-objects-ruby/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/cardmagic/solid-objects-ruby/issues","source_code_uri":"https://github.com/cardmagic/solid-objects-ruby","allowed_push_host":"https://rubygems.org","documentation_uri":"https://github.com/cardmagic/solid-objects-ruby#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"d4f13d4a8909e2a5ce84b0b2b42509eb38e507f5876bae762267c76f64f02ffd","spec_sha":"9d4014618d2dd4f832dfddf514a8091aa9c8d6c9d68fcf3958dbd5b649f7f85a","project_uri":"https://rubygems.org/gems/solid_objects","gem_uri":"https://rubygems.org/gems/solid_objects-1.0.5.gem","homepage_uri":"https://solidobjects.dev/ruby","wiki_uri":null,"documentation_uri":"https://github.com/cardmagic/solid-objects-ruby#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/cardmagic/solid-objects-ruby","bug_tracker_uri":"https://github.com/cardmagic/solid-objects-ruby/issues","changelog_uri":"https://github.com/cardmagic/solid-objects-ruby/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"benchmark","requirements":">= 0"},{"name":"brakeman","requirements":">= 0"},{"name":"