{"gems":{"name":"solid_stack_web","downloads":4281,"version":"1.6.2","version_created_at":"2026-10-27T11:51:03.167Z","version_downloads":41,"platform":"ruby","ruby_abi":null,"authors":"Chuck Smith","info":"SolidStackWeb is a mountable Rails engine that provides a production-ready operations dashboard for the full Solid Stack. It covers Solid Queue (job browser, failed job retry with inline argument editing, queue pause/resume, recurring tasks, performance stats, CSV export, and alert webhooks), Solid Cache (entry browser, size distribution, 24-hour write timeline, and optional value preview), and Solid Cable (channel browser, per-channel message list, and purge controls). Ships with dark mode, Turbo Stream responses, a JSON metrics endpoint, and no asset pipeline dependency.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/eclectic-coding/solid_stack_web","changelog_uri":"https://github.com/eclectic-coding/solid_stack_web/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/eclectic-coding/solid_stack_web"},"yanked":false,"sha":"7406c39542bf8153753d95210dc0177850fda1258ca4b2ed8e8c2a9486e46d9f","spec_sha":"8d33596ae8abf9b0c0d48a4d874502a1e7cb5d1cdb16aaf32bb534e5ceb630b6","project_uri":"https://rubygems.org/gems/solid_stack_web","gem_uri":"https://rubygems.org/gems/solid_stack_web-1.6.2.gem","homepage_uri":"https://github.com/eclectic-coding/solid_stack_web","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/eclectic-coding/solid_stack_web","bug_tracker_uri":null,"changelog_uri":"https://github.com/eclectic-coding/solid_stack_web/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"csv","requirements":">= 3.0"},{"name":"importmap-rails","requirements":">= 1.2"},{"name":"pagy","requirements":">= 43.0"},{"name":"rails","requirements":">= 8.1.3"},{"name":"solid_cable","requirements":">= 1.0"},{"name":"solid_cache","requirements":">= 1.0"},{"name":"sol