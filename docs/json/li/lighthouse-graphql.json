{"gems":{"name":"lighthouse-graphql","downloads":4711,"version":"0.7.1","version_created_at":"2026-10-18T23:33:18.234Z","version_downloads":75,"platform":"ruby","ruby_abi":null,"authors":"Vaz Innovation","info":"Lighthouse lets you build a GraphQL API for your Rails app primarily through\nschema (SDL) and server-side directives — @all, @find, @paginate, @hasMany,\n@belongsTo, @whereConditions, @orderBy, @field, @auth and more — instead of\nhand-writing a resolver for every field. It is a Ruby adaptation of the PHP\nLighthouse library (nuwave/lighthouse) built on top of graphql-ruby, with\nfirst-class Apollo Federation support so a Rails service can act as a subgraph.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","documentation_uri":"https://vaz-innovation.github.io/lighthouse-graphql/","rubygems_mfa_required":"true"},"yanked":false,"sha":"330de2016b3cb213bc3010773ec203193e1b12c4bacb3762bdb9671ec60d5c07","spec_sha":"d9e4f965fdadfbd83caafcbd304230d7b10398d16c3a2f19a4f1e3c3551b833f","project_uri":"https://rubygems.org/gems/lighthouse-graphql","gem_uri":"https://rubygems.org/gems/lighthouse-graphql-0.7.1.gem","homepage_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","wiki_uri":null,"documentation_uri":"https://vaz-innovation.github.io/lighthouse-graphql/","mailing_list_uri":null,"source_code_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","bug_tracker_uri":null,"changelog_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activesupport","requirements":">= 6.0"},{"name":"graphql","requirements":"~> 2.5"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql"}