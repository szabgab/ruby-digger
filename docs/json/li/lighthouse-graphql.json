{"gems":{"name":"lighthouse-graphql","downloads":5362,"version":"0.8.0","version_created_at":"2026-10-30T00:45:19.732Z","version_downloads":47,"platform":"ruby","ruby_abi":null,"authors":"Vaz Innovation","info":"Lighthouse lets you build a GraphQL API for your Rails app primarily through\nschema (SDL) and server-side directives — @all, @find, @paginate, @hasMany,\n@belongsTo, @whereConditions, @orderBy, @field, @auth and more — instead of\nhand-writing a resolver for every field. It is a Ruby adaptation of the PHP\nLighthouse library (nuwave/lighthouse) built on top of graphql-ruby, with\nfirst-class Apollo Federation support so a Rails service can act as a subgraph.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","documentation_uri":"https://vaz-innovation.github.io/lighthouse-graphql/","rubygems_mfa_required":"true"},"yanked":false,"sha":"655ae20cba1be168310e41064e46791adbb0b117eb2864b1aa5e40f1b63f5178","spec_sha":"e1915ff5b1090a8c46091da24f1bec1e9eeceb805d0e12bf919b2d9e734aa107","project_uri":"https://rubygems.org/gems/lighthouse-graphql","gem_uri":"https://rubygems.org/gems/lighthouse-graphql-0.8.0.gem","homepage_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","wiki_uri":null,"documentation_uri":"https://vaz-innovation.github.io/lighthouse-graphql/","mailing_list_uri":null,"source_code_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","bug_tracker_uri":null,"changelog_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activesupport","requirements":">= 6.0"},{"name":"graphql","requirements":"~> 2.5"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql"}