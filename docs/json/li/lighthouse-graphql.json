{"gems":{"name":"lighthouse-graphql","downloads":5533,"version":"0.8.2","version_created_at":"2026-10-30T02:40:02.446Z","version_downloads":43,"platform":"ruby","ruby_abi":null,"authors":"Vaz Innovation","info":"Lighthouse lets you build a GraphQL API for your Rails app primarily through\nschema (SDL) and server-side directives — @all, @find, @paginate, @hasMany,\n@belongsTo, @whereConditions, @orderBy, @field, @auth and more — instead of\nhand-writing a resolver for every field. It is a Ruby adaptation of the PHP\nLighthouse library (nuwave/lighthouse) built on top of graphql-ruby, with\nfirst-class Apollo Federation support so a Rails service can act as a subgraph.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","documentation_uri":"https://vaz-innovation.github.io/lighthouse-graphql/","rubygems_mfa_required":"true"},"yanked":false,"sha":"53abd11ced9c98365104341556fc42aa7b0dc75fab29273cf84dca53791b6609","spec_sha":"e4ed1142bd5196a1ffe6b938f9d64f58fd7481b35e0c2f717b44ca9697e63125","project_uri":"https://rubygems.org/gems/lighthouse-graphql","gem_uri":"https://rubygems.org/gems/lighthouse-graphql-0.8.2.gem","homepage_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","wiki_uri":null,"documentation_uri":"https://vaz-innovation.github.io/lighthouse-graphql/","mailing_list_uri":null,"source_code_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","bug_tracker_uri":null,"changelog_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activesupport","requirements":">= 6.0"},{"name":"graphql","requirements":"~> 2.5"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql"}