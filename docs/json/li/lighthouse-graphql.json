{"gems":{"name":"lighthouse-graphql","downloads":3838,"version":"0.2.1","version_created_at":"2026-10-17T10:11:25.727Z","version_downloads":74,"platform":"ruby","ruby_abi":null,"authors":"Vaz Innovation","info":"Lighthouse lets you build a GraphQL API for your Rails app primarily through\nschema (SDL) and server-side directives — @all, @find, @paginate, @hasMany,\n@belongsTo, @whereConditions, @orderBy, @field, @auth and more — instead of\nhand-writing a resolver for every field. It is a Ruby adaptation of the PHP\nLighthouse library (nuwave/lighthouse) built on top of graphql-ruby, with\nfirst-class Apollo Federation support so a Rails service can act as a subgraph.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","documentation_uri":"https://vaz-innovation.github.io/lighthouse-graphql/","rubygems_mfa_required":"true"},"yanked":false,"sha":"fb0e4844e8def094d04926daa27d50eb6246e4a324080bcddc6f23a8622aab62","spec_sha":"3efb7cd41a9c71ecc7fe4e37e47f4da6c771e166aebe8a3f764f81bb81e64c81","project_uri":"https://rubygems.org/gems/lighthouse-graphql","gem_uri":"https://rubygems.org/gems/lighthouse-graphql-0.2.1.gem","homepage_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","wiki_uri":null,"documentation_uri":"https://vaz-innovation.github.io/lighthouse-graphql/","mailing_list_uri":null,"source_code_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql","bug_tracker_uri":null,"changelog_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activesupport","requirements":">= 6.0"},{"name":"graphql","requirements":"~> 2.5"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Vaz-Innovation/lighthouse-graphql"}