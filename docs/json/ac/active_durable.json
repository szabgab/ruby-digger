{"gems":{"name":"active_durable","downloads":191,"version":"0.6.0","version_created_at":"2026-10-07T06:14:49.351Z","version_downloads":78,"platform":"ruby","ruby_abi":null,"authors":"William Romero","info":"ActiveDurable runs multi-step business flows (checkouts, onboarding, payouts) as durable sagas\nstored in your own database. Completed steps are checkpointed and never repeated after a crash,\nfailures before the point of no return are compensated in reverse order, and failures after it\nare retried. No Redis and no extra servers: just Active Record and Active Job.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/webresstudio/active_durable/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/webresstudio/active_durable/issues","source_code_uri":"https://github.com/webresstudio/active_durable","rubygems_mfa_required":"true"},"yanked":false,"sha":"65be4fcf6b6b3d7ffaaef87f1c891b4df5b6fe2f49f89cca2d916393a57520c6","spec_sha":"b66ebc1d336c89e50a0476fc29959a661d7683ca59dcc1f76b6d4c04fe24383d","project_uri":"https://rubygems.org/gems/active_durable","gem_uri":"https://rubygems.org/gems/active_durable-0.6.0.gem","homepage_uri":"https://webresstudio.github.io/active_durable/","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/webresstudio/active_durable","bug_tracker_uri":"https://github.com/webresstudio/active_durable/issues","changelog_uri":"https://github.com/webresstudio/active_durable/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activejob","requirements":">= 6.1, < 9"},{"name":"activerecord","requirements":">= 6.1, < 9"},{"name":"activesupport","requirements":">= 6.1, < 9"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/webresstudio/active_durable"}