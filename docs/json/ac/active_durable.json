{"gems":{"name":"active_durable","downloads":241,"version":"0.7.0","version_created_at":"2026-10-07T12:02:38.993Z","version_downloads":13,"platform":"ruby","ruby_abi":null,"authors":"William Romero","info":"ActiveDurable runs multi-step business flows (checkouts, onboarding, payouts) as durable sagas\nstored in your own database. Completed steps are checkpointed and never repeated after a crash,\nfailures before the point of no return are compensated in reverse order, and failures after it\nare retried. No Redis and no extra servers: just Active Record and Active Job.\n","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/webresstudio/active_durable/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/webresstudio/active_durable/issues","source_code_uri":"https://github.com/webresstudio/active_durable","rubygems_mfa_required":"true"},"yanked":false,"sha":"a5e73f0762c3a11eff82ea7aefe426de7cf41eff37b3d49072b417a54cc7f686","spec_sha":"8b18f2250747c9e2e03cbeaf83bc12534f625eab98fbb035b653f18d4456c316","project_uri":"https://rubygems.org/gems/active_durable","gem_uri":"https://rubygems.org/gems/active_durable-0.7.0.gem","homepage_uri":"https://webresstudio.github.io/active_durable/","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/webresstudio/active_durable","bug_tracker_uri":"https://github.com/webresstudio/active_durable/issues","changelog_uri":"https://github.com/webresstudio/active_durable/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activejob","requirements":">= 6.1, < 9"},{"name":"activerecord","requirements":">= 6.1, < 9"},{"name":"activesupport","requirements":">= 6.1, < 9"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/webresstudio/active_durable"}