{"gems":{"name":"patient_http","downloads":18207,"version":"1.8.0","version_created_at":"2026-10-23T21:00:16.338Z","version_downloads":1,"platform":"ruby","ruby_abi":null,"authors":"Brian Durand","info":"This gem provides a dedicated async HTTP processor that uses Ruby's Fiber scheduler for non-blocking I/O. Application threads hand off HTTP requests to the processor and return immediately. The processor handles hundreds of concurrent HTTP connections using fibers, then notifies the application when responses arrive via a pluggable callback mechanism. This design keeps application threads free to do other work while HTTP requests are in flight.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/bdurand/patient_http","changelog_uri":"https://github.com/bdurand/patient_http/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/bdurand/patient_http"},"yanked":false,"sha":"978b78e71605479112a8ee2a4ca71a97b8ef3e8e74c29d7a9f82eecc1c7d8f78","spec_sha":"0d25d32a8bb6dd38dd8c1ee275b080a2593382996fe19dd40b83b05f962c627b","project_uri":"https://rubygems.org/gems/patient_http","gem_uri":"https://rubygems.org/gems/patient_http-1.8.0.gem","homepage_uri":"https://github.com/bdurand/patient_http","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/bdurand/patient_http","bug_tracker_uri":null,"changelog_uri":"https://github.com/bdurand/patient_http/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"async","requirements":"~> 2.0"},{"name":"async-http","requirements":"~> 0.99"},{"name":"concurrent-ruby","requirements":"~> 1.2"},{"name":"logger","requirements":">= 0"},{"name":"protocol-http","requirements":"~> 0.66"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/bdurand/patient_http"}