{"gems":{"name":"patient_http","downloads":11909,"version":"1.5.0","version_created_at":"2026-08-27T01:02:35.267Z","version_downloads":74,"platform":"ruby","authors":"Brian Durand","info":"This gem provides a dedicated async HTTP processor that uses Ruby's Fiber scheduler for non-blocking I/O. Application threads hand off HTTP requests to the processor and return immediately. The processor handles hundreds of concurrent HTTP connections using fibers, then notifies the application when responses arrive via a pluggable callback mechanism. This design keeps application threads free to do other work while HTTP requests are in flight.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/bdurand/patient_http","changelog_uri":"https://github.com/bdurand/patient_http/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/bdurand/patient_http"},"yanked":false,"sha":"d4b19de7ad63a7df98c2cedb3a5aff93e053b5a2558ac67828f0f989a1eaba69","spec_sha":"f59cb8fdbb9f837324116d5ba658423c67184ad9caeee04d051f903e949fc4e4","project_uri":"https://rubygems.org/gems/patient_http","gem_uri":"https://rubygems.org/gems/patient_http-1.5.0.gem","homepage_uri":"https://github.com/bdurand/patient_http","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/bdurand/patient_http","bug_tracker_uri":null,"changelog_uri":"https://github.com/bdurand/patient_http/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"async","requirements":"~> 2.0"},{"name":"async-http","requirements":"~> 0.60"},{"name":"concurrent-ruby","requirements":"~> 1.2"},{"name":"logger","requirements":">= 0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/bdurand/patient_http"}