{"gems":{"name":"paper_trail-bulk_writes","downloads":1371,"version":"0.3.0","version_created_at":"2026-10-09T15:05:56.250Z","version_downloads":0,"platform":"ruby","ruby_abi":null,"authors":"Sam Robinson","info":"Bulk ActiveRecord writes skip callbacks, so PaperTrail records nothing. This gem adds\naudited_update_all, audited_delete_all and audited_insert_all, which run the bulk write\nand insert one version row per record in the same transaction, honouring the model's\nonly:, ignore:, skip:, meta: and versions: options. Ships a RuboCop cop that flags\nbare bulk writes on audited models.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes","changelog_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes","rubygems_mfa_required":"true"},"yanked":false,"sha":"8757aa1e90684fb45879f6f3ea2a762b6e132fa70dfd72537783419f1f19a70f","spec_sha":"7b54907fd6201d6a1f18ce4e89b721320bea12b153edc35b03bfcad7b10b7fef","project_uri":"https://rubygems.org/gems/paper_trail-bulk_writes","gem_uri":"https://rubygems.org/gems/paper_trail-bulk_writes-0.3.0.gem","homepage_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes","bug_tracker_uri":null,"changelog_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activerecord","requirements":">= 7.1"},{"name":"paper_trail","requirements":">= 15"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes"}