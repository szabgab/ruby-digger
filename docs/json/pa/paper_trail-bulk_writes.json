{"gems":{"name":"paper_trail-bulk_writes","downloads":1206,"version":"0.2.0","version_created_at":"2026-09-30T15:29:02.241Z","version_downloads":63,"platform":"ruby","ruby_abi":null,"authors":"Sam Robinson","info":"Bulk ActiveRecord writes skip callbacks, so PaperTrail records nothing. This gem adds\naudited_update_all, audited_delete_all and audited_insert_all, which run the bulk write\nand insert one version row per record in the same transaction, honouring the model's\nonly:, ignore:, skip:, meta: and versions: options. Ships a RuboCop cop that flags\nbare bulk writes on audited models.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes","changelog_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes","rubygems_mfa_required":"true"},"yanked":false,"sha":"bc15950fd1b3e06acfaa402500bfd51f08d641035f27433d617454d7de8180ee","spec_sha":"eaaaa86d7aac78265c3c82b5bb02253d66a9d0c0e8a371944b39ff581f8d6892","project_uri":"https://rubygems.org/gems/paper_trail-bulk_writes","gem_uri":"https://rubygems.org/gems/paper_trail-bulk_writes-0.2.0.gem","homepage_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes","bug_tracker_uri":null,"changelog_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"activerecord","requirements":">= 7.1"},{"name":"paper_trail","requirements":">= 15"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Sam-Robin/paper_trail-bulk_writes"}