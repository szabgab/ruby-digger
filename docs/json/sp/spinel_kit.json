{"gems":{"name":"spinel_kit","downloads":1893,"version":"0.3.1","version_created_at":"2026-11-12T17:52:07.484Z","version_downloads":35,"platform":"ruby","ruby_abi":null,"authors":"Ori Pekelman","info":"SpinelKit consolidates the pure-Ruby shims that every Spinel-compiled\nproject would otherwise hand-roll and that Spinel (the Ruby->native AOT\ncompiler) does not provide: .git/HEAD provenance, URL percent-codec +\nquery parsing, a minimal levelled logger, and a hex digit/byte codec.\n(JSON left in 0.3.0: Spinel now bundles `json` as a require-gated stdlib\npackage, so consumers use JSON.parse/JSON.generate directly.) Pure Ruby,\nno native extension, no runtime dependencies -- it vendors cleanly via\nbundler-spinel. Pre-alpha.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/OriPekelman/spinelkit/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/OriPekelman/spinelkit/issues","source_code_uri":"https://github.com/OriPekelman/spinelkit","documentation_uri":"https://github.com/OriPekelman/spinelkit#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"7cb2e4c72731c4d3c64c9c52a32cecaa3d45eb7b332bb8dff9f83072053490bd","spec_sha":"cee19435c4178b0cb04c373ca39dee420a04541c96e63a53fd1df1e15f4992c1","project_uri":"https://rubygems.org/gems/spinel_kit","gem_uri":"https://rubygems.org/gems/spinel_kit-0.3.1.gem","homepage_uri":"https://github.com/OriPekelman/spinelkit","wiki_uri":null,"documentation_uri":"https://github.com/OriPekelman/spinelkit#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/OriPekelman/spinelkit","bug_tracker_uri":"https://github.com/OriPekelman/spinelkit/issues","changelog_uri":"https://github.com/OriPekelman/spinelkit/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/OriPekelman/spinelkit"}