{"gems":{"name":"bundler-overrule","downloads":250,"version":"0.3.0","version_created_at":"2026-08-16T08:39:32.051Z","version_downloads":147,"platform":"ruby","authors":"Nikhil Nelson","info":"bundler-overrule is a Bundler plugin that gives application developers the final\nsay over their dependency graph. It adds `force` and `ban` to the Gemfile DSL:\n`force` rewrites every version constraint on a gem, from other gems' gemspecs and\nfrom your own Gemfile; `ban` removes a gem from resolution entirely. This is the\nRuby equivalent of Cargo's [patch], npm's overrides, and yarn's resolutions.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/TheSoloHacker47/bundler-overrule","changelog_uri":"https://github.com/TheSoloHacker47/bundler-overrule/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/TheSoloHacker47/bundler-overrule/issues","source_code_uri":"https://github.com/TheSoloHacker47/bundler-overrule","documentation_uri":"https://github.com/TheSoloHacker47/bundler-overrule#readme","rubygems_mfa_required":"true"},"yanked":false,"sha":"55c5254cda0e230c8f87886a38f9fab2dc7758e55eb017858ff5a2dcb49ee7d3","spec_sha":"cc105cc694017eb4e615e11b85117f1516d2922c3a6b462ae9939cd0e2a5e4dc","project_uri":"https://rubygems.org/gems/bundler-overrule","gem_uri":"https://rubygems.org/gems/bundler-overrule-0.3.0.gem","homepage_uri":"https://github.com/TheSoloHacker47/bundler-overrule","wiki_uri":null,"documentation_uri":"https://github.com/TheSoloHacker47/bundler-overrule#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/TheSoloHacker47/bundler-overrule","bug_tracker_uri":"https://github.com/TheSoloHacker47/bundler-overrule/issues","changelog_uri":"https://github.com/TheSoloHacker47/bundler-overrule/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/TheSoloHacker47/bundler-overrule"}