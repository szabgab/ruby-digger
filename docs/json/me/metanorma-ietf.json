{"gems":{"name":"metanorma-ietf","downloads":325722,"version":"3.7.12.pre.alpha.1","version_created_at":"2026-10-22T14:59:55.294Z","version_downloads":8,"platform":"ruby","ruby_abi":null,"authors":"Ribose Inc.","info":"metanorma-ietf lets you write IETF documents, such as Internet-Drafts and RFCs,\nin native AsciiDoc syntax. This is part of the Metanorma publishing framework.\n\nRFC XML (\"xml2rfc\" Vocabulary XML, RFC 7991) is the XML-based language used for\nwriting Internet-Drafts and RFCs, but not everyone likes hand-crafting XML,\nespecially when the focus should be on the content.\n\nThis gem is in active development.\n\nFormerly known as asciidoctor-ietf.\n","licenses":["BSD-2-Clause"],"metadata":{"rubygems_mfa_required":"true"},"yanked":false,"sha":"b1663e398c5cbb3c654c5bf42252c7415ea02793252d4f248f0092bedc85b5dd","spec_sha":"f35ed3e36e5dff8c06a2df8583c1ea5c459914e5a369f623be40d40bbaaa5c6b","project_uri":"https://rubygems.org/gems/metanorma-ietf","gem_uri":"https://rubygems.org/gems/metanorma-ietf-3.7.12.pre.alpha.1.gem","homepage_uri":"https://github.com/metanorma/metanorma-ietf","wiki_uri":null,"documentation_uri":"https://www.rubydoc.info/gems/metanorma-ietf/3.7.12.pre.alpha.1","mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"isodoc","requirements":">= 0"},{"name":"leptris","requirements":"~> 1.9"},{"name":"metanorma-document","requirements":">= 0"},{"name":"metanorma-ietf-data","requirements":">= 0"},{"name":"metanorma-standoc","requirements":">= 3.4.2"},{"name":"relaton-render","requirements":"~> 3.0.0.pre.alpha"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/metanorma/metanorma-ietf"}