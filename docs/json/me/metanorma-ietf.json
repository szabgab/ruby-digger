{"gems":{"name":"metanorma-ietf","downloads":336564,"version":"3.7.22","version_created_at":"2026-11-25T01:47:02.860Z","version_downloads":90,"platform":"ruby","ruby_abi":null,"authors":"Ribose Inc.","info":"metanorma-ietf lets you write IETF documents, such as Internet-Drafts and RFCs,\nin native AsciiDoc syntax. This is part of the Metanorma publishing framework.\n\nRFC XML (\"xml2rfc\" Vocabulary XML, RFC 7991) is the XML-based language used for\nwriting Internet-Drafts and RFCs, but not everyone likes hand-crafting XML,\nespecially when the focus should be on the content.\n\nThis gem is in active development.\n\nFormerly known as asciidoctor-ietf.\n","licenses":["BSD-2-Clause"],"metadata":{"rubygems_mfa_required":"true"},"yanked":false,"sha":"64da64e060832a490c95413f797cabf9b4a718dec71e05c54b3ee4e0af5f5583","spec_sha":"c17f11d5e2d9543f3030240e7ea55ecef0409385a48f8529117891cabb595e52","project_uri":"https://rubygems.org/gems/metanorma-ietf","gem_uri":"https://rubygems.org/gems/metanorma-ietf-3.7.22.gem","homepage_uri":"https://github.com/metanorma/metanorma-ietf","wiki_uri":null,"documentation_uri":"https://www.rubydoc.info/gems/metanorma-ietf/3.7.22","mailing_list_uri":null,"source_code_uri":null,"bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"base64","requirements":">= 0"},{"name":"isodoc","requirements":">= 0"},{"name":"leptris","requirements":"~> 1.9"},{"name":"metanorma-document","requirements":">= 0"},{"name":"metanorma-ietf-data","requirements":">= 0"},{"name":"metanorma-standoc","requirements":">= 3.4.2"},{"name":"relaton","requirements":"~> 3.1.1"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/metanorma/metanorma-ietf"}