{"gems":{"name":"crawlora","downloads":13118,"version":"1.49.0.pre.sdk.4","version_created_at":"2026-10-25T07:57:51.003Z","version_downloads":47,"platform":"ruby","ruby_abi":null,"authors":"Crawlora","info":"Crawlora is a web-scraping API for structured public web data — search, marketplace, social, finance, media, reviews, and geodata — without running your own scrapers. This gem is the official, typed, batteries-included Ruby client: grouped helpers (client.bing.search) and dynamic operation calls for every endpoint, API-key and JWT auth, automatic retries with exponential backoff and Retry-After, numeric and cursor pagination, before/after middleware hooks, and client-side rate limiting.","licenses":["MIT"],"metadata":{"homepage_uri":"https://crawlora.net/","changelog_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk/issues","source_code_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk","documentation_uri":"https://crawlora.net/docs","rubygems_mfa_required":"true"},"yanked":false,"sha":"17f4e06b0572e370a2e8b9b5234b2efd9f0703e1c825bba359e216ee4990c2e8","spec_sha":"645b9867430cd027604846b1aa121770d08344bed11bab4794cb019dc605bb12","project_uri":"https://rubygems.org/gems/crawlora","gem_uri":"https://rubygems.org/gems/crawlora-1.49.0.pre.sdk.4.gem","homepage_uri":"https://crawlora.net/","wiki_uri":null,"documentation_uri":"https://crawlora.net/docs","mailing_list_uri":null,"source_code_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk","bug_tracker_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk/issues","changelog_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk"}