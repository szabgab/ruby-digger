{"gems":{"name":"crawlora","downloads":10431,"version":"1.43.0.pre.sdk.1","version_created_at":"2026-09-26T14:44:09.027Z","version_downloads":80,"platform":"ruby","ruby_abi":null,"authors":"Crawlora","info":"Crawlora is a web-scraping API for structured public web data — search, marketplace, social, finance, media, reviews, and geodata — without running your own scrapers. This gem is the official, typed, batteries-included Ruby client: grouped helpers (client.bing.search) and dynamic operation calls for every endpoint, API-key and JWT auth, automatic retries with exponential backoff and Retry-After, numeric and cursor pagination, before/after middleware hooks, and client-side rate limiting.","licenses":["MIT"],"metadata":{"homepage_uri":"https://crawlora.net/","changelog_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk/issues","source_code_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk","documentation_uri":"https://crawlora.net/docs","rubygems_mfa_required":"true"},"yanked":false,"sha":"0e5b7298d6833a48667be605d165a8cb9a0d5102709d0d3d53b3391a3f49c7dc","spec_sha":"e3256dbd1dcfe36b0394a7011d2c0e987c3b3fb2ee6c1347287e98b4bc1ba2d9","project_uri":"https://rubygems.org/gems/crawlora","gem_uri":"https://rubygems.org/gems/crawlora-1.43.0.pre.sdk.1.gem","homepage_uri":"https://crawlora.net/","wiki_uri":null,"documentation_uri":"https://crawlora.net/docs","mailing_list_uri":null,"source_code_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk","bug_tracker_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk/issues","changelog_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/Crawlora-org/crawlora-ruby-sdk"}