{"gems":{"name":"tribble-control","downloads":268,"version":"0.5.0","version_created_at":"2026-11-25T15:00:26.523Z","version_downloads":0,"platform":"ruby","ruby_abi":null,"authors":"Stephane D'Alu","info":"Switches the ports of a USB hub -- an ExSYS 16-port managed hub\nover its internal FT232 line, or any hub that switches its own\nports, through hub-class requests (FreeBSD for now) -- and for\nthe boards on it speaks SWD through openocd and reads their\nconsoles over USB CDC.  Which board sits on which port, and\nwhich ports must never lose power, is read from a\nconfiguration, so the tool switches the bench it is told about\nand nothing else.  What a console's lines mean is left to a\ntally loaded at run time.\n","licenses":["MIT"],"metadata":{"source_code_uri":"https://github.com/sdalu/tribble-control","allowed_push_host":"https://rubygems.org","rubygems_mfa_required":"true"},"yanked":false,"sha":"008c643bfb81b11f02c2b5da95af834c181ce788f9eba7d622dc5d75585e1c04","spec_sha":"f2ab9ada2dcbd9900f410a509cdcf892d37413ca2a44e25c089794e58f72bdff","project_uri":"https://rubygems.org/gems/tribble-control","gem_uri":"https://rubygems.org/gems/tribble-control-0.5.0.gem","homepage_uri":"https://github.com/sdalu/tribble-control","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/sdalu/tribble-control","bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[{"name":"minitest","requirements":"~> 5"},{"name":"rake","requirements":">= 0"},{"name":"rubocop","requirements":">= 0"}],"runtime":[{"name":"exsys","requirements":"~> 1.2"},{"name":"parallel","requirements":">= 1.28, < 3"},{"name":"tty-logger","requirements":">= 0"},{"name":"uart","requirements":">= 0"},{"name":"ucl","requirements":"~> 0.2.0"}]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/sdalu/tribble-control"}