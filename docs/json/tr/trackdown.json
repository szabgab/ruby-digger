{"gems":{"name":"trackdown","downloads":9846,"version":"0.4.0","version_created_at":"2026-08-15T14:54:27.512Z","version_downloads":18,"platform":"ruby","authors":"rameerez","info":"Trackdown is a Ruby gem for IP geolocation in Rails applications. It reads request-bound location headers from Cloudflare and Amazon CloudFront, verifies CDN client-IP corroboration in automatic mode, or uses a local MaxMind database (BYOK). It returns country, city, emoji flag, region, continent, postal code, latitude, longitude, timezone, and related GeoIP fields.","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/rameerez/trackdown","changelog_uri":"https://github.com/rameerez/trackdown/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/rameerez/trackdown","allowed_push_host":"https://rubygems.org","rubygems_mfa_required":"true"},"yanked":false,"sha":"05b12dc27b43bfa5ebee6428a95b7db00cb0a0bb7c9ef2edd1d717a2b84726e0","spec_sha":"1518a0879b008836b63cbc560cb27af049f7cd7d456435718d65d300258b0f34","project_uri":"https://rubygems.org/gems/trackdown","gem_uri":"https://rubygems.org/gems/trackdown-0.4.0.gem","homepage_uri":"https://github.com/rameerez/trackdown","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/rameerez/trackdown","bug_tracker_uri":null,"changelog_uri":"https://github.com/rameerez/trackdown/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"countries","requirements":"~> 7.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/rameerez/trackdown"}