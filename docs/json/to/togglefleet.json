{"gems":{"name":"togglefleet","downloads":265,"version":"0.2.0","version_created_at":"2026-07-26T23:53:44.298Z","version_downloads":0,"platform":"ruby","authors":"ToggleFleet","info":"ToggleFleet is a cloud feature-flag service. This gem fetches your environment's flags, caches them, and evaluates all five gates (boolean, actor, group, % of actors, % of time) locally — so checking a flag is a hash lookup, not a network call. Background refresh uses conditional ETag requests; evaluation is byte-identical to the server.","licenses":["MIT"],"metadata":{"homepage_uri":"https://togglefleet.com","changelog_uri":"https://github.com/takeaseatventure/togglefleet-ruby/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/takeaseatventure/togglefleet-ruby/issues","source_code_uri":"https://github.com/takeaseatventure/togglefleet-ruby","documentation_uri":"https://togglefleet.com/docs","rubygems_mfa_required":"true"},"yanked":false,"sha":"069a086b60222ba4092532925435e543971a07381a3acc94001622b34e469aa0","spec_sha":"650df8aae542265a056b6d0a5919fef3474327c7bfb81eb23217393b62cb254a","project_uri":"https://rubygems.org/gems/togglefleet","gem_uri":"https://rubygems.org/gems/togglefleet-0.2.0.gem","homepage_uri":"https://togglefleet.com","wiki_uri":null,"documentation_uri":"https://togglefleet.com/docs","mailing_list_uri":null,"source_code_uri":"https://github.com/takeaseatventure/togglefleet-ruby","bug_tracker_uri":"https://github.com/takeaseatventure/togglefleet-ruby/issues","changelog_uri":"https://github.com/takeaseatventure/togglefleet-ruby/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":null,"vcs_uri":"https://github.com/takeaseatventure/togglefleet-ruby"}