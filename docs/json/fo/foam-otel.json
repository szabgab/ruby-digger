{"gems":{"name":"foam-otel","downloads":8472,"version":"2.0.0","version_created_at":"2026-07-30T00:07:55.103Z","version_downloads":195,"platform":"ruby","authors":"Foam","info":"A thin, safe wrapper over the official OpenTelemetry libraries: foam owns the pipeline (providers, batch processors, OTLP export to the foam fleet endpoint, opt-in key-list redaction — zero redaction by default), turns on automatic tier-1/2 instrumentation, and ships a small set of never-throw helpers. Configure with Foam::Otel.init(name:, environment:, enabled:, token:); the ingest token is passed EXPLICITLY — the fleet convention is to read it from the FOAM_OTEL_TOKEN environment variable and hand it to init. The gem never reads the token (or any config) from the environment itself. Built to docs/BASE_PACKAGE_SPEC.md; full usage in the README (shown on the source page and on rubydoc.info, not on the RubyGems gem page).","licenses":["Nonstandard"],"metadata":{"homepage_uri":"https://github.com/foam-ai/packages","source_code_uri":"https://github.com/foam-ai/packages/tree/main/ruby/foam-otel","rubygems_mfa_required":"true"},"yanked":false,"sha":"e0b537506342f1232858e3455e1325648ebea267bde467bc7deb52436d81d246","spec_sha":"fabe9d10b689c89caaf05440cc50d6bdad2f853eb5fe9312d5f165120ac83203","project_uri":"https://rubygems.org/gems/foam-otel","gem_uri":"https://rubygems.org/gems/foam-otel-2.0.0.gem","homepage_uri":"https://github.com/foam-ai/packages","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/foam-ai/packages/tree/main/ruby/foam-otel","bug_tracker_uri":null,"changelog_uri":null,"funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"opentelemetry-api","requirements":"~> 1.1"},{"name":"opentelemetry-exporter-otlp","requirements":">= 0.30, < 0.35"},{"name":"opentelemetry-exporter-otlp-logs","requirements":">= 0.5, < 0.6"},{"name":"opentelemetry-exporter-otlp-metrics","requirements":">= 0.9, < 0.11"},{"name":"opentelemetry-i