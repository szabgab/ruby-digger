{"gems":{"name":"janela","downloads":6571,"version":"0.10.0","version_created_at":"2026-09-28T13:27:51.334Z","version_downloads":75,"platform":"ruby","ruby_abi":null,"authors":"Jay Killeen, Vanessa Soares","info":"Janela lets you define dashboards directly on your ActiveRecord models and associations. Slicers, cross-filtering charts, and dimension drill-down as first-class Rails citizens, not a bolted-on admin panel. Built on Ruby and Stimulus so it drops onto any Rails application with no separate frontend build step. Dashboards can run live and interactive for internal analysts, or be published as locked, static views for external audiences, from the same underlying definition.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/retail-tasker/janela/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/retail-tasker/janela/issues","source_code_uri":"https://github.com/retail-tasker/janela","allowed_push_host":"https://rubygems.org","rubygems_mfa_required":"true"},"yanked":false,"sha":"78b3c6a6d8471c67bdfec1a63a699e83a4f24bb547a8e53aca594f690292f60c","spec_sha":"9cbcf5f8d287b3332329e6c936670b8319c393ed8abdb7bb5e2afcacf9087c7c","project_uri":"https://rubygems.org/gems/janela","gem_uri":"https://rubygems.org/gems/janela-0.10.0.gem","homepage_uri":"https://github.com/retail-tasker/janela","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/retail-tasker/janela","bug_tracker_uri":"https://github.com/retail-tasker/janela/issues","changelog_uri":"https://github.com/retail-tasker/janela/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"groupdate","requirements":">= 6.0"},{"name":"rails","requirements":">= 8.0"},{"name":"ransack","requirements":">= 4.0"},{"name":"stimulus-rails","requirements":">= 1.3"},{"name":"turbo-rails","requirements":">= 2.0"}]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/retail-tasker/janela"}