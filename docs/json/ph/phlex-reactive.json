{"gems":{"name":"phlex-reactive","downloads":21098,"version":"0.15.1","version_created_at":"2026-10-12T17:48:41.742Z","version_downloads":32,"platform":"ruby","ruby_abi":null,"authors":"Mikael Henriksson","info":"phlex-reactive makes Phlex components reactive without writing Stimulus\ncontrollers or hand-picking Turbo Stream targets. Declare actions in Ruby;\na single generic client runtime turns clicks and form input into a server\nround trip that re-renders the component and morphs it back in. Components\nself-target by a stable DOM id, so the same unit re-renders for client\nactions AND server-pushed broadcasts. State lives in the database behind a\nsigned identity — no attacker-controlled snapshot. Pairs with pgbus for\nreliable, transactional, reconnect-safe live updates with no Action Cable\nand no Redis.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/zoolutions/phlex-reactive","changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","rubygems_mfa_required":"true"},"yanked":false,"sha":"84c85952f33d267350f4d2b5909b30546246708371b793939e40b2809af6261b","spec_sha":"132310e81efbcd8d77e277d0f424beffad9df948afb420985fc01e4469a5da19","project_uri":"https://rubygems.org/gems/phlex-reactive","gem_uri":"https://rubygems.org/gems/phlex-reactive-0.15.1.gem","homepage_uri":"https://github.com/zoolutions/phlex-reactive","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","bug_tracker_uri":null,"changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"globalid","requirements":"~> 1.0"},{"name":"phlex-rails","requirements":">= 2.0, < 3"},{"name":"railties","requirements":">= 7.1, < 9.0"},{"name":"turbo-rails","requirements":">= 1.5, < 3"},{"name":"zeitwerk","requirem