{"gems":{"name":"phlex-reactive","downloads":17629,"version":"0.13.2","version_created_at":"2026-09-14T04:51:56.935Z","version_downloads":31,"platform":"ruby","ruby_abi":null,"authors":"Mikael Henriksson","info":"phlex-reactive makes Phlex components reactive without writing Stimulus\ncontrollers or hand-picking Turbo Stream targets. Declare actions in Ruby;\na single generic client runtime turns clicks and form input into a server\nround trip that re-renders the component and morphs it back in. Components\nself-target by a stable DOM id, so the same unit re-renders for client\nactions AND server-pushed broadcasts. State lives in the database behind a\nsigned identity — no attacker-controlled snapshot. Pairs with pgbus for\nreliable, transactional, reconnect-safe live updates with no Action Cable\nand no Redis.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/zoolutions/phlex-reactive","changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","rubygems_mfa_required":"true"},"yanked":false,"sha":"cba2a4a4c1666e04f6ab292171e51122ad04f80136d556c2c21bac389c5b93ad","spec_sha":"b031a97e0b7cb3551c419c6bdcc988b5e0aca567c296af82844ffb55fd613b4b","project_uri":"https://rubygems.org/gems/phlex-reactive","gem_uri":"https://rubygems.org/gems/phlex-reactive-0.13.2.gem","homepage_uri":"https://github.com/zoolutions/phlex-reactive","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","bug_tracker_uri":null,"changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"globalid","requirements":"~> 1.0"},{"name":"phlex-rails","requirements":">= 2.0, < 3"},{"name":"railties","requirements":">= 7.1, < 9.0"},{"name":"turbo-rails","requirements":">= 1.5, < 3"},{"name":"zeitwerk","requirem