{"gems":{"name":"phlex-reactive","downloads":15717,"version":"0.13.0","version_created_at":"2026-08-30T23:40:07.120Z","version_downloads":179,"platform":"ruby","ruby_abi":null,"authors":"Mikael Henriksson","info":"phlex-reactive makes Phlex components reactive without writing Stimulus\ncontrollers or hand-picking Turbo Stream targets. Declare actions in Ruby;\na single generic client runtime turns clicks and form input into a server\nround trip that re-renders the component and morphs it back in. Components\nself-target by a stable DOM id, so the same unit re-renders for client\nactions AND server-pushed broadcasts. State lives in the database behind a\nsigned identity — no attacker-controlled snapshot. Pairs with pgbus for\nreliable, transactional, reconnect-safe live updates with no Action Cable\nand no Redis.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/zoolutions/phlex-reactive","changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","rubygems_mfa_required":"true"},"yanked":false,"sha":"328be3f88b3b71cd0fdf8c24823898a5357f7637252d6c32487328f6fd5f4b55","spec_sha":"ffdb18e8d6bef5fb8470e9ab454a5d058df8e6dd072b72695d05f754757f7cc8","project_uri":"https://rubygems.org/gems/phlex-reactive","gem_uri":"https://rubygems.org/gems/phlex-reactive-0.13.0.gem","homepage_uri":"https://github.com/zoolutions/phlex-reactive","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","bug_tracker_uri":null,"changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"globalid","requirements":"~> 1.0"},{"name":"phlex-rails","requirements":">= 2.0, < 3"},{"name":"railties","requirements":">= 7.1, < 9.0"},{"name":"turbo-rails","requirements":">= 1.5, < 3"},{"name":"zeitwerk","require