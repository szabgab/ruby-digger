{"gems":{"name":"phlex-reactive","downloads":23485,"version":"0.16.4","version_created_at":"2026-10-18T12:39:18.044Z","version_downloads":52,"platform":"ruby","ruby_abi":null,"authors":"Mikael Henriksson","info":"phlex-reactive makes Phlex components reactive without writing Stimulus\ncontrollers or hand-picking Turbo Stream targets. Declare actions in Ruby;\na single generic client runtime turns clicks and form input into a server\nround trip that re-renders the component and morphs it back in. Components\nself-target by a stable DOM id, so the same unit re-renders for client\nactions AND server-pushed broadcasts. State lives in the database behind a\nsigned identity — no attacker-controlled snapshot. Pairs with pgbus for\nreliable, transactional, reconnect-safe live updates with no Action Cable\nand no Redis.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/zoolutions/phlex-reactive","changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","rubygems_mfa_required":"true"},"yanked":false,"sha":"86db8d14698fd8ac46f8c624db4a57c4e958256d5a6e584bff167a9d6fe98df5","spec_sha":"dd51ec8746b65289f0eae7e0ecfdc49e108075bc83542d50bea7dbba12834ab2","project_uri":"https://rubygems.org/gems/phlex-reactive","gem_uri":"https://rubygems.org/gems/phlex-reactive-0.16.4.gem","homepage_uri":"https://github.com/zoolutions/phlex-reactive","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","bug_tracker_uri":null,"changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"globalid","requirements":"~> 1.0"},{"name":"phlex-rails","requirements":">= 2.0, < 3"},{"name":"railties","requirements":">= 7.1, < 9.0"},{"name":"turbo-rails","requirements":">= 1.5, < 3"},{"name":"zeitwerk","requirem