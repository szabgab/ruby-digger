{"gems":{"name":"phlex-reactive","downloads":26486,"version":"0.16.12","version_created_at":"2026-10-31T19:32:05.572Z","version_downloads":85,"platform":"ruby","ruby_abi":null,"authors":"Mikael Henriksson","info":"phlex-reactive makes Phlex components reactive without writing Stimulus\ncontrollers or hand-picking Turbo Stream targets. Declare actions in Ruby;\na single generic client runtime turns clicks and form input into a server\nround trip that re-renders the component and morphs it back in. Components\nself-target by a stable DOM id, so the same unit re-renders for client\nactions AND server-pushed broadcasts. State lives in the database behind a\nsigned identity — no attacker-controlled snapshot. Pairs with pgbus for\nreliable, transactional, reconnect-safe live updates with no Action Cable\nand no Redis.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/zoolutions/phlex-reactive","changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","rubygems_mfa_required":"true"},"yanked":false,"sha":"01555268c68294186c02357d2919b2fd3f3f9bcdd6dcb60213d8c46df319fdce","spec_sha":"9018fd29e6575c66007dfaf419a222c856d2f2b00c5f19fbb0e4b75d22fae94e","project_uri":"https://rubygems.org/gems/phlex-reactive","gem_uri":"https://rubygems.org/gems/phlex-reactive-0.16.12.gem","homepage_uri":"https://github.com/zoolutions/phlex-reactive","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/zoolutions/phlex-reactive/tree/main","bug_tracker_uri":null,"changelog_uri":"https://github.com/zoolutions/phlex-reactive/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[{"name":"globalid","requirements":"~> 1.0"},{"name":"phlex-rails","requirements":">= 2.0, < 3"},{"name":"railties","requirements":">= 7.1, < 9.0"},{"name":"turbo-rails","requirements":">= 1.5, < 3"},{"name":"zeitwerk","requir