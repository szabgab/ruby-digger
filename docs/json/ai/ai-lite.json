{"gems":{"name":"ai-lite","downloads":5176,"version":"1.2.0","version_created_at":"2026-11-02T06:58:52.999Z","version_downloads":0,"platform":"ruby","ruby_abi":null,"authors":"William Basmayor","info":"AI Lite is a lightweight Ruby client for OpenAI and Gemini, built for Rails apps and plain Ruby projects. It uses only Ruby's standard library and has no runtime gem dependencies.\n\nBoth providers support chat, streaming, function calling, embeddings, image generation, speech, transcription, token counting, and model checks. OpenAI also supports moderation. Gemini also supports structured media inputs and a YouTube helper.","licenses":["MIT"],"metadata":{"changelog_uri":"https://github.com/wbasmayor/ai-lite/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/wbasmayor/ai-lite/issues","source_code_uri":"https://github.com/wbasmayor/ai-lite","documentation_uri":"https://github.com/wbasmayor/ai-lite#readme"},"yanked":false,"sha":"3676b4eb9792d0168c813c2b674b8c5957bf3b44d710053483a552c872d1f6d5","spec_sha":"e9c868876c0abbc6ff994ac1f7850335b335e33ead493c3ff6210ac2f5618436","project_uri":"https://rubygems.org/gems/ai-lite","gem_uri":"https://rubygems.org/gems/ai-lite-1.2.0.gem","homepage_uri":"https://github.com/wbasmayor/ai-lite","wiki_uri":null,"documentation_uri":"https://github.com/wbasmayor/ai-lite#readme","mailing_list_uri":null,"source_code_uri":"https://github.com/wbasmayor/ai-lite","bug_tracker_uri":"https://github.com/wbasmayor/ai-lite/issues","changelog_uri":"https://github.com/wbasmayor/ai-lite/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":1,"github_actions":1,"vcs_uri":"https://github.com/wbasmayor/ai-lite"}