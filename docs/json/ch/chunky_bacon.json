{"gems":{"name":"chunky_bacon","downloads":626,"version":"0.1.3","version_created_at":"2026-10-01T12:16:46.623Z","version_downloads":120,"platform":"ruby","ruby_abi":null,"authors":"Andi Idogawa","info":"The companion gem of \"Learn Ruby with Chunky Bacon\", an interactive Ruby course that runs in the browser. require \"chunky_bacon\" gives a program the course's helpers - show_image, show_pdf, show_browser, download_file, mock_get, show_irb, show_files, run_tests, install_gem - so code written in the course runs unchanged with plain Ruby; `chunkybacon run` starts a program with them loaded. Pure Ruby, no dependencies.","licenses":["MIT","CC-BY-SA-4.0"],"metadata":{"homepage_uri":"https://chunkybacon.idogawa.com","changelog_uri":"https://github.com/Largo/chunkybacon/blob/main/gem/chunky_bacon/CHANGELOG.md","source_code_uri":"https://github.com/Largo/chunkybacon/tree/main/gem/chunky_bacon","rubygems_mfa_required":"true"},"yanked":false,"sha":"185b88c34482f9f37f745674b8187f0daa18f4b74f41f18ec0565289c5d3c3eb","spec_sha":"6630351b8e71cb36a666c6e46be2d42ed550670bdfa7c4f205815d7e65ec3804","project_uri":"https://rubygems.org/gems/chunky_bacon","gem_uri":"https://rubygems.org/gems/chunky_bacon-0.1.3.gem","homepage_uri":"https://chunkybacon.idogawa.com","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/Largo/chunkybacon/tree/main/gem/chunky_bacon","bug_tracker_uri":null,"changelog_uri":"https://github.com/Largo/chunkybacon/blob/main/gem/chunky_bacon/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":null,"vcs_error":"ERROR","vcs_uri":"https://github.com/Largo/chunkybacon/tree/main/gem/chunky_bacon"}