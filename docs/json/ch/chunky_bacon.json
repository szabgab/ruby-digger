{"gems":{"name":"chunky_bacon","downloads":294,"version":"0.1.2","version_created_at":"2026-10-01T10:25:35.440Z","version_downloads":77,"platform":"ruby","ruby_abi":null,"authors":"Andi Idogawa","info":"The companion gem of \"Learn Ruby with Chunky Bacon\", an interactive Ruby course that runs in the browser. require \"chunky_bacon\" gives a program the course's helpers - show_image, show_pdf, show_browser, download_file, mock_get, show_irb, show_files, run_tests, install_gem - so code written in the course runs unchanged with plain Ruby; `chunkybacon run` starts a program with them loaded. Pure Ruby, no dependencies.","licenses":["MIT","CC-BY-SA-4.0"],"metadata":{"homepage_uri":"https://chunkybacon.idogawa.com","changelog_uri":"https://github.com/Largo/chunkybacon/blob/main/gem/chunky_bacon/CHANGELOG.md","source_code_uri":"https://github.com/Largo/chunkybacon/tree/main/gem/chunky_bacon","rubygems_mfa_required":"true"},"yanked":false,"sha":"ad62e358f97f82224eca642fcf9435bbe009380dcfa0ea723f121217c564fd45","spec_sha":"5738bc5b9c4df329543e2ea68f4175336ce4487fb74a410666099f4a28f10e36","project_uri":"https://rubygems.org/gems/chunky_bacon","gem_uri":"https://rubygems.org/gems/chunky_bacon-0.1.2.gem","homepage_uri":"https://chunkybacon.idogawa.com","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/Largo/chunkybacon/tree/main/gem/chunky_bacon","bug_tracker_uri":null,"changelog_uri":"https://github.com/Largo/chunkybacon/blob/main/gem/chunky_bacon/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[],"runtime":[]}},"vcs_name":"GitHub","ci":null,"vcs_error":"ERROR","vcs_uri":"https://github.com/Largo/chunkybacon/tree/main/gem/chunky_bacon"}