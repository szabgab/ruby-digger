{"gems":{"name":"pg_pipeline","downloads":3561,"version":"0.3.0","version_created_at":"2026-08-08T12:37:59.343Z","version_downloads":109,"platform":"ruby","authors":"Roman Hajdarov","info":"A driver-adjacent Ruby control-plane over ruby-pg/libpq. It multiplexes\nindependent, session-neutral extended-protocol operations from many fibers\nonto a small number of PostgreSQL connections while keeping explicit\ntransactions and session-changing work on exclusive pinned connections.\nRequires any Fiber::Scheduler host (Async::Scheduler, Itsi::Scheduler, …);\nthe gem does not depend on a particular reactor. Control-plane only: all\nwire work stays in libpq.\n","licenses":["MIT"],"metadata":{"homepage_uri":"https://github.com/roman-haidarov/pg_pipeline","changelog_uri":"https://github.com/roman-haidarov/pg_pipeline/blob/main/CHANGELOG.md","bug_tracker_uri":"https://github.com/roman-haidarov/pg_pipeline/issues","source_code_uri":"https://github.com/roman-haidarov/pg_pipeline/tree/main"},"yanked":false,"sha":"bc112f7d1df7a7d4e1e30780037309d3ff09b908f433f7624682c08f9a2067af","spec_sha":"07c1f5d1ece7fed60a49d800e2d5e925b67e43cd53d193aa72aa2a12602720c6","project_uri":"https://rubygems.org/gems/pg_pipeline","gem_uri":"https://rubygems.org/gems/pg_pipeline-0.3.0.gem","homepage_uri":"https://github.com/roman-haidarov/pg_pipeline","wiki_uri":null,"documentation_uri":null,"mailing_list_uri":null,"source_code_uri":"https://github.com/roman-haidarov/pg_pipeline/tree/main","bug_tracker_uri":"https://github.com/roman-haidarov/pg_pipeline/issues","changelog_uri":"https://github.com/roman-haidarov/pg_pipeline/blob/main/CHANGELOG.md","funding_uri":null,"dependencies":{"development":[{"name":"async","requirements":"~> 2.42"},{"name":"rake","requirements":"~> 13.0"},{"name":"rspec","requirements":"~> 3.13"},{"name":"ruby-prof","requirements":"~> 1.7"},{"name":"stackprof","requirements":"~> 0.2"}],"runtime":[{"name":"pg","requirements":">= 1.5, < 2"}]}},"vcs_name":"GitHub","ci":null,"vcs_error"